# ============================================
# Environment Variables — LOCAL DEVELOPMENT
# Copy to .env.docker and fill in the values
# For production (Coolify), set these in each service's env config.
# ============================================

# ── Supabase (Required) ─────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Frontend Build Args ─────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: Set to your backend's public URL.
# In production this is your API domain (e.g. https://api.example.com)
# In local dev this is http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001

# ── Ports (local dev only) ──────────────────
FRONTEND_PORT=80
BACKEND_PORT=3001

# ── CORS ─────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set to your frontend domain(s).
# Example: https://example.com,https://www.example.com
CORS_ORIGINS=*

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Email (Optional — fill if using) ────────
# RESEND_API_KEY=re_xxxxx
# SENDGRID_API_KEY=SG.xxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
