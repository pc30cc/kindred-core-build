# ============================================
# Environment Variables — LOCAL DEVELOPMENT
# Copy to .env.docker and fill in the values
# For production (Coolify), set these in each service's env config.
# ============================================

# ── Supabase (Required) ─────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Frontend Build Args ─────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: Set to your backend's public URL.
# In production this is your API domain (e.g. https://api.example.com)
# In local dev this is http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001

# Frontend nginx same-origin /api proxy target (runtime variable).
# MUST be a bare origin with no trailing /api path. The entrypoint also
# normalizes an accidental trailing /api defensively.
BACKEND_URL=http://backend:3001

# ── Ports (local dev only) ──────────────────
FRONTEND_PORT=80
BACKEND_PORT=3001

# ── CORS ─────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin, cookie-
# authenticated dashboard requests. REQUIRED if the frontend is served from
# a different origin than this API (a genuinely same-origin reverse-proxy
# deployment doesn't need this set at all — browsers don't consult CORS for
# same-origin requests).
#
# Leaving this at "*" (or unset) does NOT open cross-origin access — the
# server treats that as "not configured" and rejects credentialed
# cross-origin requests by default (fail closed), it does not fail open to
# every origin. Set it explicitly to your real frontend domain(s) below if
# you need cross-origin browser calls to work.
# Example: https://example.com,https://www.example.com
CORS_ORIGINS=*

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Application base URL (auth emails) ──────
# The dashboard's public https URL, used to build the links inside
# verification/password-reset emails. Prefer setting this via the admin UI
# instead (Super Admin → Domains → app_base_url) — that takes priority over
# this env var. With CORS_ORIGINS left at "*" above, the server has no real
# origin to fall back to for these links, so in production it fails loudly
# instead of ever emailing a broken "*/auth/..." link.
# APP_BASE_URL=https://app.example.com

# ── Email (Optional — fill if using) ────────
# RESEND_API_KEY=re_xxxxx
# SENDGRID_API_KEY=SG.xxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Workspace Invitations v5.1 (Required) ─────────────
# Generate two distinct secrets: openssl rand -hex 32
INVITATION_LINK_SECRET=
INVITATION_OTP_PEPPER=
INVITATION_LINK_SECRET_RING=
INVITATION_LINK_KEY_VERSION=1

# -- Verification peppers (Required for OTP) -----------
# Generate with: openssl rand -hex 32
# Both fail CLOSED. Leave PHONE_VERIFICATION_PEPPER unset and every phone
# OTP -- including the Super Admin "resend code" button -- answers
# `phone_verification_unavailable` (HTTP 503) without contacting your SMS
# provider at all. That looks exactly like a broken SMS provider, so check
# this first before suspecting the provider.
# PHONE_VERIFICATION_PEPPER   min 16 chars -- phone OTP
# GENERIC_VERIFICATION_PEPPER min 32 chars -- signup email OTP and guest
#                             order lookup (Generic Verification Core)
PHONE_VERIFICATION_PEPPER=
GENERIC_VERIFICATION_PEPPER=
# Required in plan-authoritative mode; acceptance fails closed if omitted.
SELF_HOST_SEAT_LIMIT=
INVITATION_WORKER_INPROC=0

# ── Realtime: Centrifugo (Required by docker-compose.yml) ─────────────
# docker compose refuses to start the centrifugo service until these are set
# — there are no built-in defaults any more. Generate each secret with:
#   openssl rand -hex 32
# The backend uses the SAME two values (CENTRIFUGO_TOKEN_HMAC_SECRET signs
# client connection tokens; CENTRIFUGO_API_KEY authenticates server→Centrifugo
# publishes), so set them once here.
CENTRIFUGO_TOKEN_HMAC_SECRET=
CENTRIFUGO_API_KEY=
# Browser origins allowed to open a realtime connection, SPACE-separated.
# Never "*". Local dev example: http://localhost:80 http://localhost:5173
CENTRIFUGO_ALLOWED_ORIGINS=
# The port is published on 127.0.0.1 only. Put a TLS reverse proxy in front
# of it and point browsers at the public wss:// URL below.
# CENTRIFUGO_PORT=8000
# CENTRIFUGO_WS_URL=wss://realtime.example.com/connection/websocket
# The Centrifugo admin UI is disabled in docker-compose.yml.
