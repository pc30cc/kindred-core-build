# Frontend Environment Variables
# Copy this to .env and fill in the values

# Required — Supabase (initial provider implementation)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Required — Self-hosted backend URL
VITE_API_BASE_URL=http://localhost:3001

# Optional — preview-only widget snippet (login page).
# Set these when the panel and widget assets are served from different
# origins. If unset, the login-page preview snippet is skipped (the
# embedded widget on customer sites is unaffected — it always uses the
# loader URL configured in widget_platform_settings).
VITE_WIDGET_LOADER_BASE_URL=
VITE_WIDGET_ASSET_BASE_URL=

# ── Plugin Platform & Channels Runtime (server-side only) ─────────────
# These are NEVER exposed to the browser. Each is a distinct secret; the
# server refuses to boot if any of them reuse each other or the service-role
# key. Generate with: openssl rand -hex 32
#
# Core API + Channels Worker:
#   PLUGIN_SECRETS_MASTER_KEY  AES-256-GCM key encrypting plugin credentials
#                              (bot tokens). Losing it means re-connecting
#                              every integration; rotating it requires
#                              re-entering credentials.
# Core API + Channels Gateway:
#   CHANNELS_WEBHOOK_SIGNING_KEY  HMAC key. Each integration's provider
#                                 webhook secret is DERIVED from it, so
#                                 rotating it invalidates every registered
#                                 webhook until they are re-registered.
# Core API + Gateway + Worker:
#   CORE_INTERNAL_SECRET       bearer secret for /internal/channels/*
#
PLUGIN_SECRETS_MASTER_KEY=
CHANNELS_WEBHOOK_SIGNING_KEY=
CORE_INTERNAL_SECRET=

# Public HTTPS origin of the Channels Gateway. Provider webhook URLs are built
# ONLY from this value — never from a request Host/Origin header.
PUBLIC_CHANNELS_BASE_URL=https://channels.example.com

# Internal address of Core, used by the Gateway and the Channels Worker.
CORE_INTERNAL_BASE_URL=http://localhost:3001

# ── Workspace Invitations v5.1 (server/worker only) ────────────────
# Generate two DIFFERENT values with: openssl rand -hex 32
INVITATION_LINK_SECRET=
INVITATION_OTP_PEPPER=
# Rotation ring format: version:secret,version:secret. Keep old versions until
# every invitation derived from them has expired.
INVITATION_LINK_SECRET_RING=
INVITATION_LINK_KEY_VERSION=1
# Required unless SELF_HOST_BILLING_MODE=unlimited; missing value fails closed.
SELF_HOST_SEAT_LIMIT=
# Development-only fallback. Production runs WORKER_KIND=invitations separately.
INVITATION_WORKER_INPROC=0

# ── AI PROVIDER NETWORK ISOLATION ─────────────────────────────────────
# Core never opens a socket to an AI provider. Every completion, connection
# test and embedding is delegated to the AI Runtime, which is deployed on the
# UNRESTRICTED network (see Dockerfile.ai):
#
#   restricted:  frontend + Core + DB  ──HTTPS──▶  unrestricted: ai-runtime ──▶ providers
#
# Core side (both required for any AI feature to work):
AI_RUNTIME_URL=https://ai-runtime.example.com
# Shared bearer secret. Must be identical on Core and the AI Runtime, and MUST
# NOT reuse CORE_INTERNAL_SECRET / CHANNELS_WEBHOOK_SIGNING_KEY — Core refuses
# to start if the boundaries share a secret.
AI_RUNTIME_INTERNAL_SECRET=

# AI Runtime side (in addition to AI_RUNTIME_INTERNAL_SECRET). The runtime is
# stateless: never give it SUPABASE_SERVICE_ROLE_KEY, PLUGIN_SECRETS_MASTER_KEY
# or SESSION_SECRET — it refuses to start if it sees them.
AI_RUNTIME_PORT=3021
# Optional tuning (bounded; same semantics as before the split):
# AI_HTTP_TIMEOUT_MS=12000
# AI_RETRY_ATTEMPTS=2
# AI_TOTAL_BUDGET_MS=28000

# Optional — Channels Gateway / Worker tuning
CHANNELS_PORT=3011
CHANNELS_POLL_INTERVAL_MS=1500
CHANNELS_BATCH_SIZE=10
CHANNELS_LEASE_SECONDS=120
