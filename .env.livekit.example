# .env.livekit.example
#
# Environment variables for the standalone LiveKit Coolify service.
# Copy these into the LiveKit resource's "Environment Variables" panel
# in Coolify. Do NOT commit a filled-in copy of this file.
#
# All variables here are consumed by docker-compose.livekit.yml.
# The main app/backend services have their OWN .env (see .env.example
# and server/.env.example). The api_key/api_secret pair below MUST
# also be entered in the main app at:
#   Super Admin → Providers → Calls → LiveKit
# so the backend can mint participant tokens that this server accepts.

# ----- REQUIRED -----------------------------------------------------------

# LiveKit's auth keys. Single line, format: "<api_key>: <api_secret>".
# Generate with:
#   API_KEY=$(openssl rand -hex 16)
#   API_SECRET=$(openssl rand -hex 32)
#   echo "$API_KEY: $API_SECRET"
# The api_key MUST start with a letter (LiveKit convention: "API" prefix
# is common, e.g. "APIabc123...").
LIVEKIT_KEYS=APIyourapikey: yourverylongapisecret

# Same api_key as above, used by LiveKit to sign outgoing webhook requests.
LIVEKIT_WEBHOOK_API_KEY=APIyourapikey

# Public IP of the host running this LiveKit container. REQUIRED.
# Without this, LiveKit advertises the container's internal Docker IP in
# ICE candidates and remote browsers cannot establish media streams.
# Find with: curl -s https://api.ipify.org
LIVEKIT_NODE_IP=203.0.113.10

# ----- OPTIONAL -----------------------------------------------------------

# Multi-node Redis. Leave empty for single-node deployments.
# Format: "host:port" (e.g. "redis:6379" if you add a redis service to
# docker-compose.livekit.yml).
LIVEKIT_REDIS_ADDRESS=

# TURN/TLS domain. Required ONLY if you enable `turn:` in livekit.yaml.
# This domain must resolve to the same host as the LiveKit container,
# and you must hold a valid TLS certificate for it.
LIVEKIT_TURN_DOMAIN=

# Logging level: debug | info | warn | error
LIVEKIT_LOG_LEVEL=info