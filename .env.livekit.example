# .env.livekit.example
#
# Environment variables for the standalone LiveKit Coolify service.
# Copy these into the LiveKit resource's "Environment Variables" panel
# in Coolify. Do NOT commit a filled-in copy of this file.
#
# All variables here are consumed by docker-compose.livekit.yml. At
# container startup, a small shell wrapper renders a real YAML config to
# /tmp/livekit.yaml using these values, then execs livekit-server against
# that file. There is NO bind-mounted config file and NO inline YAML blob.
#
# The main app/backend services have their OWN .env. The LIVEKIT_API_KEY
# and LIVEKIT_API_SECRET values MUST also be entered in the main app at:
#   Super Admin -> Providers -> Calls -> LiveKit
# so the backend can mint participant tokens that this server accepts.

# ----- REQUIRED -----------------------------------------------------------

# LiveKit API key (identifier). Generate: openssl rand -hex 16
LIVEKIT_API_KEY=APIyourapikey

# LiveKit API secret (signing secret). Generate: openssl rand -hex 32
LIVEKIT_API_SECRET=yourverylongapisecret

# Public IP of the host running this LiveKit container. REQUIRED.
# Without this, LiveKit advertises the container's internal Docker IP in
# ICE candidates and remote browsers cannot establish media streams.
# Find with: curl -s https://api.ipify.org
LIVEKIT_NODE_IP=203.0.113.10

# ----- OPTIONAL -----------------------------------------------------------

# Pinned LiveKit server image tag. MUST be compatible with the bundled
# livekit-client UMD that the standalone Call Center widget ships
# (public/call-widget/vendor/livekit-client.umd.min.js). Modern clients
# call /rtc/v1/validate on connect — older server tags (1.7.x) return 404
# on that path and the browser shows "v1 RTC path not found". If you must
# pin an older tag for other reasons, also pin a compatible client SDK.
LIVEKIT_IMAGE_TAG=v1.8.4

# Logging level: debug | info | warn | error
LIVEKIT_LOG_LEVEL=info

# Same value as LIVEKIT_API_KEY. Only set if you enable LiveKit webhooks
# pointing at the backend's /api/webhooks/livekit endpoint.
LIVEKIT_WEBHOOK_API_KEY=

# Redis. Leave empty for a single standalone node. Required for multi-node
# LiveKit, where nodes discover each other through Redis and must all point at
# the SAME instance.
# Format: "host:port" (e.g. "redis:6379").
LIVEKIT_REDIS_ADDRESS=
# Optional Redis auth / database index (leave empty when Redis has no password).
LIVEKIT_REDIS_USERNAME=
LIVEKIT_REDIS_PASSWORD=
LIVEKIT_REDIS_DB=0

# ----- TURN (relay) -------------------------------------------------------
#
# Empty domain = TURN off, which is the default and what every deployment
# before this ran. Media then reaches LiveKit over UDP 50000-50100, or TCP
# 7881 when UDP is blocked. That covers home and mobile networks. It does
# not cover a network that allows nothing but 80 and 443 outbound, which is
# most corporate, hotel and guest wifi — those visitors negotiate signalling
# fine and then fail to pass any media.
#
# Setting this hostname turns LiveKit's own TURN server on. It mints a TURN
# credential per participant and hands it over the signalling connection, so
# nothing goes in the app's RTC endpoint settings — do NOT paste a turn: URL
# there, an ICE server with no credentials is a broken route, not a spare
# one. Instead enter the same hostname at
#   Super Admin -> Providers -> Calls -> LiveKit -> TURN domain
# which is what stops the backend reporting that no relay is configured.
#
# The hostname must resolve to THIS host directly. Behind Cloudflare it must
# be a DNS-only record (grey cloud): the orange-cloud proxy carries HTTP and
# WebSocket, never TURN.
LIVEKIT_TURN_DOMAIN=

# Where TURN listens. The UDP port rescues nothing the media range does not
# already cover, so the one that matters is the TLS port: put it on 443 if
# you can, because 443 is the port restrictive networks allow. Sharing 443
# with the Coolify/Traefik front end needs a TCP router matching this
# hostname by SNI — see the comment at the foot of
# docker-compose.livekit.yml. On its own IP or a spare port, 5349 is the
# conventional choice.
# Behind a proxy (the usual case on Coolify) set the TLS port to 443: it is
# both what LiveKit advertises to clients and what it listens on inside its
# own container, where nothing else holds the port. The proxy terminates TLS
# on the host's 443 and forwards by SNI. Only when LiveKit holds its own
# certificate and nothing fronts it does 5349 make sense — and then the port
# has to be published in docker-compose.livekit.yml, which it is not by
# default.
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_TURN_TLS_PORT=443

# The proxy's certificate resolver, which is what puts a real certificate in
# front of the TLS port. On Coolify it is `letsencrypt`; confirm against an
# existing router if this install differs. LEAVE IT EMPTY when TURN is off:
# the router still exists, and an empty resolver is what stops it asking for
# a certificate for a hostname that does not resolve.
LIVEKIT_TURN_CERTRESOLVER=

# The proxy entrypoint carrying 443. `https` on Coolify.
LIVEKIT_TURN_ENTRYPOINT=https

# Who terminates TLS on the TLS port. true (the default) means something in
# front does it — Traefik, nginx — and LiveKit speaks plain TCP behind it.
# Ignored when a certificate pair is given below, in which case LiveKit
# terminates TLS itself. Exactly one of the two must be true; the other way
# round gives a port that answers with the wrong protocol and fails only on
# the networks TURN exists for.
LIVEKIT_TURN_EXTERNAL_TLS=true

# A certificate for LIVEKIT_TURN_DOMAIN, when LiveKit should terminate TLS
# itself rather than sit behind a proxy. Both or neither; one alone is
# ignored and falls back to external TLS.
LIVEKIT_TURN_CERT_FILE=
LIVEKIT_TURN_KEY_FILE=

# Ports a relay allocates. Pinned next to the media range instead of
# LiveKit's 30000-40000 default so the set is small, predictable, and the
# one docker-compose.livekit.yml publishes.
LIVEKIT_TURN_RELAY_PORT_START=50101
LIVEKIT_TURN_RELAY_PORT_END=50200
