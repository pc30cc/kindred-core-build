# .env.livekit.example
#
# Environment variables for the standalone LiveKit Coolify service.
# Copy these into the LiveKit resource's "Environment Variables" panel
# in Coolify. Do NOT commit a filled-in copy of this file.
#
# All variables here are consumed by docker-compose.livekit.yml. At
# container startup, a small shell wrapper renders a real YAML config to
# /tmp/livekit.yaml using these values, then execs livekit-server against
# that file. There is NO bind-mounted config file and NO inline YAML blob.
#
# The main app/backend services have their OWN .env. The LIVEKIT_API_KEY
# and LIVEKIT_API_SECRET values MUST also be entered in the main app at:
#   Super Admin -> Providers -> Calls -> LiveKit
# so the backend can mint participant tokens that this server accepts.

# ----- REQUIRED -----------------------------------------------------------

# LiveKit API key (identifier). Generate: openssl rand -hex 16
LIVEKIT_API_KEY=APIyourapikey

# LiveKit API secret (signing secret). Generate: openssl rand -hex 32
LIVEKIT_API_SECRET=yourverylongapisecret

# Public IP of the host running this LiveKit container. REQUIRED.
# Without this, LiveKit advertises the container's internal Docker IP in
# ICE candidates and remote browsers cannot establish media streams.
# Find with: curl -s https://api.ipify.org
LIVEKIT_NODE_IP=203.0.113.10

# ----- OPTIONAL -----------------------------------------------------------

# Pinned LiveKit server image tag. MUST be compatible with the bundled
# livekit-client UMD that the standalone Call Center widget ships
# (public/call-widget/vendor/livekit-client.umd.min.js). Modern clients
# call /rtc/v1/validate on connect — older server tags (1.7.x) return 404
# on that path and the browser shows "v1 RTC path not found". If you must
# pin an older tag for other reasons, also pin a compatible client SDK.
LIVEKIT_IMAGE_TAG=v1.8.4

# Logging level: debug | info | warn | error
LIVEKIT_LOG_LEVEL=info

# Same value as LIVEKIT_API_KEY. Only set if you enable LiveKit webhooks
# pointing at the backend's /api/webhooks/livekit endpoint.
LIVEKIT_WEBHOOK_API_KEY=

# Redis. Leave empty ONLY for a single standalone node with no telephony.
# REQUIRED as soon as LiveKit SIP is deployed (ops/telephony): livekit-server
# and livekit-sip discover each other exclusively over this Redis bus, and both
# must point at the SAME instance. Also required for multi-node LiveKit.
# Format: "host:port" (e.g. "redis:6379").
LIVEKIT_REDIS_ADDRESS=
# Optional Redis auth / database index (leave empty when Redis has no password).
LIVEKIT_REDIS_USERNAME=
LIVEKIT_REDIS_PASSWORD=
LIVEKIT_REDIS_DB=0

# Reserved for a future TURN/TLS rollout. Leave empty for now.
LIVEKIT_TURN_DOMAIN=
