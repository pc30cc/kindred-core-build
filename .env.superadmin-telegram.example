# Dedicated private Super Admin Telegram technical bot
WORKER_KIND=superadmin-telegram

# Standard server read access (the bot performs reads only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Existing isolated AI Runtime boundary
AI_RUNTIME_URL=https://ai-runtime.example.com
AI_RUNTIME_INTERNAL_SECRET=replace-with-existing-ai-runtime-secret

# Dedicated Telegram bot. DO NOT reuse a customer/channel bot token: this
# worker owns getUpdates and removes any webhook on startup.
SUPERADMIN_TELEGRAM_BOT_TOKEN=123456789:replace-me
# Comma-separated numeric Telegram USER ids. Private chats only.
SUPERADMIN_TELEGRAM_ALLOWED_USER_IDS=123456789
SUPERADMIN_TELEGRAM_MAX_REQUESTS_PER_MINUTE=12

# Realtime Redis/Valkey, for live technical telemetry only. Prefer the same URL
# already used by the realtime cluster. Never expose this value to Telegram.
REALTIME_REDIS_URL=redis://:password@realtime-redis:6379/0
# Alternatively, if candidate-index Redis is separate:
# VISITOR_CANDIDATE_INDEX_REDIS_URL=redis://:password@realtime-redis:6379/0

# Optional dedicated AI provider for this bot. If omitted, the worker READS
# app_runtime_config.default_ai_provider and uses it statelessly via AI Runtime.
# No ai_usage_logs/billing run is written either way.
# SUPERADMIN_TELEGRAM_AI_PROVIDER=openai
# SUPERADMIN_TELEGRAM_AI_API_KEY=sk-...
# SUPERADMIN_TELEGRAM_AI_MODEL=gpt-4o-mini
# SUPERADMIN_TELEGRAM_AI_MAX_TOKENS=1200
# SUPERADMIN_TELEGRAM_AI_TEMPERATURE=0.2
# SUPERADMIN_TELEGRAM_AI_BASE_URL=
# SUPERADMIN_TELEGRAM_AI_ORG_ID=
