# ── Frontend Build ──────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json bun.lockb* package-lock.json* ./
RUN npm install --ignore-scripts

COPY . .

# Build-time env vars (pass via --build-arg or Coolify env)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_BASE_URL

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# Fail the build loudly if the widget manifest wasn't produced. Without it,
# nginx would 404 on /widget/widget-manifest.json and the loader would fall
# back to unhashed assets — which silently breaks production.
RUN test -f /app/dist/widget/widget-manifest.json || (echo "❌ widget-manifest.json missing from build output" && ls -la /app/dist/widget/ && exit 1)
RUN echo "✅ widget assets:" && ls -la /app/dist/widget/

# ── Serve with nginx ───────────────────────────────────────
FROM nginx:alpine

# envsubst lives in gettext on alpine; nginx:alpine already ships it via
# /docker-entrypoint.d, but we install explicitly so we don't depend on
# upstream packaging choices.
RUN apk add --no-cache gettext

# Static build artifacts
COPY --from=build /app/dist /usr/share/nginx/html

# Nginx CONFIG TEMPLATE (note: NOT default.conf — that path is reserved
# for the rendered output produced by our entrypoint). Keeping it under
# /etc/nginx/templates/ avoids any chance of nginx loading the raw,
# unrendered template directly.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Custom entrypoint: validates env, renders template, execs nginx.
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Verify widget assets landed in the runtime image
RUN test -f /usr/share/nginx/html/widget/widget-manifest.json || (echo "❌ widget-manifest.json missing in nginx image" && exit 1)

EXPOSE 80

# Override the default nginx image's ENTRYPOINT (/docker-entrypoint.sh
# from the upstream image). Ours does the env validation + envsubst and
# then execs nginx itself — so we set CMD to a no-op marker that the
# entrypoint ignores.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD []
