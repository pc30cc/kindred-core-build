# ── Frontend Build ──────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json bun.lockb* package-lock.json* ./
RUN npm install --ignore-scripts

COPY . .

# Build-time env vars (pass via --build-arg or Coolify env)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_BASE_URL

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# Fail the build loudly if the widget manifest wasn't produced. Without it,
# nginx would 404 on /widget/widget-manifest.json and the loader would fall
# back to unhashed assets — which silently breaks production.
RUN test -f /app/dist/widget/widget-manifest.json || (echo "❌ widget-manifest.json missing from build output" && ls -la /app/dist/widget/ && exit 1)
RUN echo "✅ widget assets:" && ls -la /app/dist/widget/

# ── Serve with nginx ───────────────────────────────────────
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html

# Site config is a TEMPLATE — entrypoint substitutes ${BACKEND_URL} at start.
COPY nginx.conf /etc/nginx/conf.d/default.conf.template
COPY deploy/nginx/nginx-main.conf /etc/nginx/nginx.conf
COPY deploy/nginx/docker-entrypoint.sh /docker-entrypoint-custom.sh
RUN chmod +x /docker-entrypoint-custom.sh

# Verify widget assets landed in the runtime image
RUN test -f /usr/share/nginx/html/widget/widget-manifest.json || (echo "❌ widget-manifest.json missing in nginx image" && exit 1)

# Default upstream for local docker-compose. Override with BACKEND_URL env in Coolify.
ENV BACKEND_URL=http://backend:3001

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint-custom.sh"]
