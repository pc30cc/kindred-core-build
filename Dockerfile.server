# ── Backend Server ─────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app

# Build identity — stamped in so /internal/channels/ready and
# /internal/channels/auth-diagnostic can PROVE which commit answered a
# request instead of reporting build=unknown forever. Pass --build-arg
# APP_VERSION=$(git rev-parse --short HEAD) (docker-compose.yml and
# COOLIFY_DEPLOY.md do this); falls back to "unknown" only if the builder
# genuinely never supplied one.
ARG APP_VERSION=unknown
ENV APP_VERSION=${APP_VERSION}

# Copy and install server dependencies
COPY server/package.json server/package-lock.json* ./
RUN npm install

# server/routes/workspaceSmartRules.ts imports these via a relative path
# (`../../src/lib/widget/smartRules.js`) that assumes the original monorepo
# layout with `server/` and `src/` as siblings — so they must land at
# /src/lib/widget, outside WORKDIR, to satisfy that import. But Node's
# module resolution for smartRules.ts's own bare-specifier import
# (`import { z } from 'zod'`) walks up from /src/lib/widget looking for a
# node_modules directory, and never reaches /app/node_modules where `zod`
# actually got installed above. Symlink the root node_modules to /app's so
# that walk terminates successfully instead of throwing MODULE_NOT_FOUND.
RUN ln -s /app/node_modules /node_modules

# Copy server source code
COPY server/ .

COPY src/lib/widget/smartEngine.ts /src/lib/widget/smartEngine.ts
COPY src/lib/widget/smartRules.ts /src/lib/widget/smartRules.ts

# Cross-cutting pure modules shared with the Channels Gateway. Server code is
# copied to /app (WORKDIR), so relative imports like `../shared/...` from
# /app/config.ts resolve to /shared — same sibling-layout reason as /src above.
COPY shared /shared


# Standalone Call Widget static assets — served by the API origin so
# legacy/install snippets pointing at the API base keep working
# (see server/index.ts static mounts under /call-widget).
COPY public/call-widget ./public/call-widget
COPY public/widget/vendor ./public/widget/vendor

# Build-time verification — fail fast if the image is missing the
# standalone widget assets the API is expected to serve.
RUN test -f /app/public/call-widget/l.js          || (echo "❌ public/call-widget/l.js missing"          && exit 1)
RUN test -f /app/public/call-widget/runtime.js    || (echo "❌ public/call-widget/runtime.js missing"    && exit 1)
RUN test -f /app/public/call-widget/runtime.css   || (echo "❌ public/call-widget/runtime.css missing"   && exit 1)
RUN test -f /app/public/widget/vendor/livekit-client.umd.min.js || (echo "❌ livekit-client.umd.min.js missing" && exit 1)

EXPOSE 3001

# Run TypeScript directly with tsx
CMD ["npx", "tsx", "index.ts"]
