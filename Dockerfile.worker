# ── Multi-Worker Image ─────────────────────────────────────────────
# A single image, multiple Coolify services. Pick the worker loop with:
#   WORKER_KIND=intelligence   → AI KB Builder (public.ai_kb_jobs)
#   WORKER_KIND=source-sync    → Data Hub sync (public.ai_source_sync_jobs)
#   WORKER_KIND=all            → both (dev/small deploys only)
# Default kind is "intelligence" for backward compatibility.
#
# Required env (all kinds):
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#
# Optional env (kind-aware; new names preferred, old names still work):
#   WORKER_ID | AI_KB_WORKER_ID
#   WORKER_INTERVAL_MS | AI_KB_WORKER_INTERVAL_MS | AI_KB_WORKER_POLL_MS
#   WORKER_LOCK_TTL_SECONDS | AI_KB_WORKER_LOCK_TTL_SECONDS
#   CRAWLER_TIMEOUT_MS / CRAWLER_MAX_BYTES / CRAWLER_USER_AGENT  (intelligence + source-sync)
#
# Build from repo root:
#   docker build -f Dockerfile.worker -t growth-suite-worker .
# Run (intelligence):
#   docker run --rm -e WORKER_KIND=intelligence --env-file .env growth-suite-worker
# Run (source-sync):
#   docker run --rm -e WORKER_KIND=source-sync  --env-file .env growth-suite-worker

FROM node:20-alpine
WORKDIR /app

# Install root deps. `tsx` is a runtime dependency (see package.json) so a
# normal production install includes it — no devDependencies, no network
# fetch at container start.
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev || npm install --omit=dev

# Worker code + the small slice of server code it imports.
COPY worker ./worker
COPY shared ./shared
COPY server ./server
COPY tsconfig.json ./
COPY tsconfig.server.json ./

# tsx runs TypeScript directly — same approach as Dockerfile.server.
ENV NODE_ENV=production
ENV AI_KB_WORKER_STANDALONE=1
ENV WORKER_KIND=intelligence

# Use the locally installed tsx binary — no network fetch at startup.
# Verified at build time so the image fails fast if tsx is missing.
RUN test -f node_modules/tsx/dist/cli.mjs || (echo "❌ tsx not installed" && ls node_modules/.bin | head && exit 1)
CMD ["node", "node_modules/tsx/dist/cli.mjs", "worker/index.ts"]