# Gradle / Android build output
build/
.gradle/
local.properties
*.apk
*.aab
*.iml

# Android Studio
.idea/
captures/
.externalNativeBuild/
.cxx/

# Written by Gradle 9 when it provisions a daemon JVM, and it names the JDK
# of whichever machine ran the build. Committing it pins everyone else to a
# path that does not exist for them. CI sets JAVA_HOME explicitly instead.
gradle/gradle-daemon-jvm.properties

# Generated by driving a device, and kept — the runner has no emulator, so
# this is the one artifact CI cannot rebuild. Listed here as an exception so
# a future `generated/` rule cannot quietly drop it.
!app/src/main/generated/baselineProfiles/

# Signing material, never. Play ties the app's identity to this key for as
# long as the app exists: a committed keystore lets anyone who has cloned the
# repository sign an update to it, and revoking that is not a thing you can
# do — the only remedy is a new listing under a new package name, with none
# of the installs.
#
# `tools/make-release-keystore.sh` creates one outside version control and
# says where to keep it. Passwords never belong in a file at all.
*.jks
*.keystore
*.p12
*.pepk
keystore.properties
signing.properties

# Firebase's client configuration is supplied at build time
# (WEBYAR_FIREBASE_* — see app/build.gradle.kts), never as a committed
# google-services.json: one project's keys in the repository is every fork
# and every CI log registering devices against it.
google-services.json
