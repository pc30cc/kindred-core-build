# Gradle / Android build output
build/
.gradle/
local.properties
*.apk
*.aab
*.iml

# Android Studio
.idea/
captures/
.externalNativeBuild/
.cxx/

# Written by Gradle 9 when it provisions a daemon JVM, and it names the JDK
# of whichever machine ran the build. Committing it pins everyone else to a
# path that does not exist for them. CI sets JAVA_HOME explicitly instead.
gradle/gradle-daemon-jvm.properties

# Generated by driving a device, and kept — the runner has no emulator, so
# this is the one artifact CI cannot rebuild. Listed here as an exception so
# a future `generated/` rule cannot quietly drop it.
!app/src/main/generated/baselineProfiles/
