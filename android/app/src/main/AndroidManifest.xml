<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The app talks to a server, which on Android has to be said out loud.
      Its absence is silent: every request throws a SecurityException that
      surfaces as a transport failure, so the app looks offline on a working
      connection. It went unnoticed here because the sample backend answers
      from memory and needs no network at all.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Notifications. Android 13 and up will not deliver one to an app the
      person has not said yes to, and the operator is asked from the
      notifications settings screen — where they have just gone looking for
      exactly this — rather than at launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Voice notes. Requested at the moment the operator taps the microphone,
      never at launch: a permission dialog on first run, before anyone has
      asked for anything, is how an app teaches people to say no.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The call route switches the audio device and holds focus while a call
         is up; without these the loudspeaker toggle silently does nothing on
         some vendors' builds. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      A phone with no microphone is a tablet, and it should still be able to
      read an inbox. required="false" keeps this app installable on one.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Not required: an operator on a tablet with no camera can still take a
         voice call, and a required feature would hide the app from them in
         the store entirely. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!--
      `WebyarApp` builds the app's graph lazily and configures Coil and
      WorkManager; see its class note. Backup stays off exactly as before:
      the cache database and the attachment files are covered by the same
      `data_extraction_rules.xml` as the session token.
    -->
    <application
        android:name=".WebyarApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Webyar"
        android:supportsRtl="true">

        <!--
          `configChanges` handles the whole set rather than letting Android
          recreate the Activity. Compose reads the configuration through
          `LocalConfiguration` and recomposes from it, so nothing is lost by
          handling these — and a great deal is gained on the call screen,
          where a recreation would tear down the video renderer and rebuild
          it in front of the operator. Turning a phone during a call is the
          ordinary way that happens.

          `resizeableActivity` is the default at this target, but it is said
          out loud because a tablet in split screen and a foldable opening are
          the two cases most likely to be forgotten.
        -->
        <!--
          `singleTop`: a notification tapped while the app is open reaches
          this same activity through `onNewIntent` and opens the conversation
          on top of where the operator was, rather than stacking a second
          copy of the whole app underneath the first.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Webyar"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|fontScale|layoutDirection|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          How an attachment reaches the app that can read it.

          Handing another app a `file://` URI has thrown `FileUriExposedException`
          since API 24, which is this app's floor, so a PDF the operator taps
          has to go out as a content URI with a one-shot read grant. The
          authority is namespaced under the package so a debug build installed
          beside a release one does not collide with it — two providers
          claiming one authority is an install failure, not a runtime one.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attachment_paths" />
        </provider>

        <!--
          FCM delivers here with the app in front; with it in the background
          the system draws the notification itself and this is not called.
          Not exported: only Google Play services' own intent reaches it.
        -->
        <service
            android:name=".core.push.WebyarMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          How the system draws a push that arrives in the background: in the
          app's own channel (the id the server names in every message) and
          with a silhouette icon rather than a white square.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="webyar_messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_message" />
        <!--
          No token until somebody signs in: the registrar turns this on when
          it first asks for one, and off again at sign-out.
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!--
          WorkManager starts when first asked (`WebyarApp` is its
          Configuration.Provider), not from a content provider at every
          launch: it has nothing to do at cold start, and a cold start is
          what this app is measured on.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
