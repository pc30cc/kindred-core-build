<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon for a message notification.

  A silhouette, because that is all Android draws there: the system paints
  every opaque pixel in one colour, so the launcher's shaded ribbons would
  arrive as a solid square. A speech bubble is what the notification is
  about; it is also what FCM uses when it draws a background notification
  itself (`default_notification_icon` in the manifest).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,2H4c-1.1,0 -2,0.9 -2,2v18l4,-4h14c1.1,0 2,-0.9 2,-2V4c0,-1.1 -0.9,-2 -2,-2z" />
</vector>
