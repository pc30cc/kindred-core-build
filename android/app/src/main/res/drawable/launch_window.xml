<?xml version="1.0" encoding="utf-8"?>
<!--
  The window before the first frame: the launch colour with the loader at
  rest in the middle, where the system splash (Android 12 and later) draws it
  too — so what follows is the same loader starting to turn, not a cut.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center"
        android:drawable="@drawable/launch_loader" />
</layer-list>
