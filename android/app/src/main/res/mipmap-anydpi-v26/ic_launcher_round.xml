<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      Android 13 and later tint this with the wallpaper's palette, so it is
      the mark as a shape and nothing else. It is also the only reduction of
      the mark that works: a silhouette does not care that the ribbons are
      shaded, only where their outline is.
    -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
