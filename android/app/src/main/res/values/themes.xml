<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this exists only so the window has a
         background and the system bars are transparent before the first
         frame. Without it the launch shows the platform default and then
         flashes to the app's own colour. -->
    <style name="Theme.Webyar" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
