# mail-relay's secrets. Copy to .env next to docker-compose.yml (chmod 600)
# and fill in; never commit .env. Names only here.

# SASL users of the relay: "noreply@webyar.ai:<password>,noreply@respok.app:<password>".
# Each password is also the smtp_pass of that brand's Super Admin → Email provider.
SMTPD_SASL_USERS=

# The queue volume production's relay already uses (docker inspect mail-relay).
# SPOOL_VOLUME=

# Bounce watcher: each brand's events token, the same value as the events_token
# of that brand's Super Admin → Email provider (smtp). A brand without one is
# not reported to.
EVENTS_TOKEN_WEBYAR_AI=
EVENTS_TOKEN_RESPOK_APP=

# Optional: Telegram alerts on deferred mail and a growing queue (off when unset).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# QUEUE_ALERT_THRESHOLD=20
# ALERT_INTERVAL_MINUTES=60
