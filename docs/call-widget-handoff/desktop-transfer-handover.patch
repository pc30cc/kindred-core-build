+    [Fact]
+    public void Handover_waits_for_the_identity_the_transfer_named()
+    {
+        // Operators join as an opaque reference; the transfer's answer names the colleague's.
+        const string me = "operator:0123456789abcdef", them = "operator:fedcba9876543210";
+        string?[] room = ["visitor:abc", me, them];
+        Assert.True(Handover.Joined(room, me, "u2", them));
+        Assert.False(Handover.Joined(room, me, "u2", "operator:1111111111111111"));
+        // Without a named identity (a server from before it) only `operator:<user id>` is the colleague.
+        Assert.False(Handover.Joined(room, me, "u2"));
+        Assert.True(Handover.Joined(["operator:me", "operator:u2"], "operator:me", "u2", "operator:1111111111111111"));
+        // A department the server picked someone for: that one, not any other operator.
+        Assert.False(Handover.Joined(room, me, null, "operator:1111111111111111"));
+        Assert.True(Handover.Joined(room, me, null, them));
+        Assert.True(Handover.Joined(room, me, null, null));
+    }
+
+    [Fact]
+    public async Task Transfer_returns_the_identity_the_colleague_joins_under()
+    {
+        var (api, _) = Make((_, _) => (HttpStatusCode.OK,
+            """{"ok":true,"assigned_agent_id":"u2","assigned_participant_identity":"operator:fedcba9876543210","department_id":null,"handoff":"manual"}"""));
+        Assert.Equal("operator:fedcba9876543210", await api.TransferCallAsync("w1", "c1", "u2", null, null));
+        var (older, _) = Make((_, _) => (HttpStatusCode.OK, """{"ok":true,"assigned_agent_id":"u2","department_id":null}"""));
+        Assert.Null(await older.TransferCallAsync("w1", "c1", "u2", null, null));
+    }
+
