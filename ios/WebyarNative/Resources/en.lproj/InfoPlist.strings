/* The name under the icon, and the two sentences iOS itself puts in front of
   someone the first time the app asks for a camera or a microphone. These are
   drawn by the system, not by the app, so `Str` cannot reach them — they are
   localized here or they are English for everybody. */
"CFBundleDisplayName" = "Webyar";
"NSMicrophoneUsageDescription" = "Webyar uses the microphone when you call a visitor from a conversation.";
"NSCameraUsageDescription" = "Webyar uses the camera when you start a video call with a visitor.";
