# ─────────────────────────────────────────────────────────────────────
# nginx config TEMPLATE — rendered at container start by docker-entrypoint.sh
# via `envsubst`. Only variables explicitly listed in the entrypoint are
# substituted; all other `$vars` (e.g. $uri, $host, $remote_addr) are passed
# through untouched so nginx can interpret them at request time.
#
# REQUIRED ENV VARS (entrypoint will fail fast if missing):
#   - BACKEND_URL   e.g. https://api.example.com   (no trailing slash)
# ─────────────────────────────────────────────────────────────────────

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ─────────────────────────────────────────────────────────────────
    # DNS resolver — REQUIRED so nginx does not crash at startup when
    # the backend hostname (BACKEND_URL) is not yet resolvable. Without
    # this, nginx tries to resolve the upstream once at config-load time
    # and exits with: `host not found in upstream`.
    #
    # 127.0.0.11 = embedded Docker DNS (works in Coolify/Compose/Swarm).
    # We also fall back to public resolvers so external hostnames
    # (e.g. api.yourdomain.com pointing at a separate service) resolve
    # even if the embedded DNS doesn't know them.
    #
    # `valid=` controls how long answers are cached; `ipv6=off` avoids
    # AAAA lookups when the host has no IPv6 (faster + fewer warnings).
    # ─────────────────────────────────────────────────────────────────
    resolver 127.0.0.11 1.1.1.1 8.8.8.8 valid=30s ipv6=off;
    resolver_timeout 5s;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;

    # ─────────────────────────────────────────────────────────────────
    # Optional /api/ reverse proxy to backend.
    # The frontend normally calls the backend directly via VITE_API_BASE_URL,
    # but exposing /api/ here lets same-origin deploys work too.
    # BACKEND_URL is substituted at container start by envsubst.
    #
    # IMPORTANT: we assign BACKEND_URL to a `set` variable and use it in
    # `proxy_pass`. This forces nginx to resolve the hostname at REQUEST
    # time (via the `resolver` above) instead of at startup, so the
    # container boots even if the backend DNS isn't ready yet.
    # ─────────────────────────────────────────────────────────────────
    location /api/ {
        set $backend_url "${BACKEND_URL}";
        proxy_pass $backend_url/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_ssl_server_name on;
        proxy_read_timeout 300s;
        proxy_connect_timeout 60s;
    }

    # ─────────────────────────────────────────────────────────────────
    # Runtime deployment config — NEVER cache. Lets an operator point the
    # dashboard at a different API domain by editing/mounting this one file
    # (no rebuild). Empty apiBaseUrl = same-origin via the /api/ proxy above.
    # ─────────────────────────────────────────────────────────────────
    location = /runtime-config.js {
        root /usr/share/nginx/html;
        types { } default_type application/javascript;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        try_files /runtime-config.js =404;
    }

    # ─────────────────────────────────────────────────────────────────────
    # Widget assets — MUST be served as static files. Never fall back to
    # index.html, otherwise the loader receives the SPA HTML instead of
    # widget-manifest.json / runtime JS and customers load a broken widget.
    # ─────────────────────────────────────────────────────────────────────

    # Widget loader — never cache so widget config/domain changes apply immediately
    location = /widget/loader.js {
        root /usr/share/nginx/html;
        # Explicit script content-type so Firefox ORB / Chrome CORB do not
        # block this third-party script when the host page is on another
        # origin. Without an explicit type, nginx's MIME guess + the global
        # `X-Content-Type-Options: nosniff` can produce an
        # "OpaqueResponseBlocking" failure where the script never runs.
        types { } default_type application/javascript;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header X-Widget-Asset "loader" always;
        add_header Access-Control-Allow-Origin "*" always;
        # CORP must be cross-origin so browsers (Firefox ORB / Safari) allow
        # this asset to be loaded as a script from a third-party origin.
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        # Force Cloudflare (and any CDN that honors these headers) to bypass
        # cache. Without this, even with `no-store` in Cache-Control, CF can
        # still cache based on its own Cache Rules / default policy.
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        try_files /widget/loader.js =404;
    }

    # Widget manifest — never cache, must always return JSON (or 404). Never HTML.
    location = /widget/widget-manifest.json {
        root /usr/share/nginx/html;
        default_type application/json;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Widget-Asset "manifest" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        # See note above — Cloudflare-aware cache bypass.
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        try_files /widget/widget-manifest.json =404;
    }

    # All other widget assets (hashed runtime js/css) — immutable long cache.
    # Uses regex prefix so it wins over the SPA fallback `location /`.
    #
    # ─── WIDGET-FONT-CORS (post-mortem) ──────────────────────────────
    # Symptom: customer pages logged "CORS error" for
    # /widget/fonts/iransans-*.woff2 even though this block sets
    # `Access-Control-Allow-Origin: *`. The origin config was correct —
    # the responses customers received did not come from this block:
    #   1. .woff2 is in the CDN's default "cache everything by extension"
    #      list. Copies fetched BEFORE the ACAO header was added here were
    #      still being served from the edge, header-less. `CDN-Cache-Control`
    #      / `Cloudflare-CDN-Cache-Control` (set below) are honoured only on
    #      Enterprise plans, so origin `no-store` did not evict them.
    #   2. `/widget/fonts/` is not content-addressed, so the stale edge copy
    #      never rotated on deploy — unlike hashed assets.
    # Fix (architectural, not a workaround): font bytes now ship inside a
    # CONTENT-HASHED presentation asset (presentation-<id>-fonts.css) with
    # the faces inlined as data: URLs. No font subresource request is made
    # at all, and any future byte change produces a new URL, so a stale edge
    # copy is impossible. The raw .woff2 files stay on disk only as build
    # inputs. If they are ever served directly again, purge the CDN cache
    # for /widget/fonts/* after any header change.
    # ─────────────────────────────────────────────────────────────────
    location ^~ /widget/ {
        root /usr/share/nginx/html;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;


        # ─────────────────────────────────────────────────────────────
        # Cache policy split:
        #   • Hashed assets  (e.g. runtime.4f424b04.css)  → immutable 1y
        #   • Unhashed assets (e.g. runtime.css)           → no-store
        #
        # WHY: Both `public/widget/runtime.css` (unhashed, dev-only) and
        # `dist/widget/runtime.HASH.css` (hashed, prod) end up under
        # /usr/share/nginx/html/widget/. If we cache the UNHASHED file
        # for a year, any request that ever falls back to it (because
        # the backend manifest was stale or a host CDN cached a stale
        # config) will pin the OLD widget styles for that user for a
        # full year. That was the exact symptom: "sometimes the old
        # style appears." We now refuse to long-cache unhashed runtime
        # files — only the content-addressed ones get immutable.
        # ─────────────────────────────────────────────────────────────
        location ~* "^/widget/.*\.[a-f0-9]{8}\.(?:js|css)$" {
            root /usr/share/nginx/html;
            # Force MIME so Firefox ORB / Chrome CORB cannot mis-classify
            # the response and refuse to execute it as a script.
            types {
                application/javascript js;
                text/css              css;
            }
            expires 365d;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            add_header X-Widget-Asset "runtime-hashed" always;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Cross-Origin-Resource-Policy "cross-origin" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            try_files $uri =404;
        }

        # Unhashed runtime/css/js fallbacks — never cache. If any client
        # ever loads these by accident, we want them to re-validate next
        # time so a fresh deploy converges.
        types {
            application/javascript js;
            text/css              css;
            application/json      json;
            font/woff2            woff2;
            font/woff             woff;
        }
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        add_header X-Widget-Asset "runtime-unhashed" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        # Hard 404 — DO NOT fall back to index.html for /widget/* paths.
        try_files $uri =404;
    }

    # Cache other static assets
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ─────────────────────────────────────────────────────────────────────
    # Call Center widget assets — these are NOT content-hashed (loader +
    # runtime live at fixed paths under /call-widget/). If we let nginx
    # fall through to `location /` they pick up heuristic browser caching
    # AND Cloudflare's default Edge TTL, which is exactly what caused
    # "some browsers show the new widget, others show the old one even
    # after a CF cache purge". Force no-store on the loader/runtime so
    # every page load re-validates. Only the vendor SDK (LiveKit UMD) is
    # safe to cache long-term because its filename is stable AND its
    # contents are pinned to a specific upstream version.
    # ─────────────────────────────────────────────────────────────────────
    location ^~ /call-widget/ {
        root /usr/share/nginx/html;
        types {
            application/javascript js;
            text/css              css;
            application/json      json;
        }
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;

        # Long-cache the self-hosted vendor SDK (stable contents).
        location ~* "^/call-widget/vendor/" {
            root /usr/share/nginx/html;
            expires 365d;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Cross-Origin-Resource-Policy "cross-origin" always;
            try_files $uri =404;
        }

        # Loader + runtime (unhashed) — never cache anywhere.
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Surrogate-Control "no-store" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        add_header X-Widget-Asset "call-widget" always;
        try_files $uri =404;
    }

    # SPA fallback — only for non-widget paths
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
