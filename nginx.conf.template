# ─────────────────────────────────────────────────────────────────────
# nginx config TEMPLATE — rendered at container start by docker-entrypoint.sh
# via `envsubst`. Only variables explicitly listed in the entrypoint are
# substituted; all other `$vars` (e.g. $uri, $host, $remote_addr) are passed
# through untouched so nginx can interpret them at request time.
#
# REQUIRED ENV VARS (entrypoint will fail fast if missing):
#   - BACKEND_URL   e.g. https://api.example.com   (no trailing slash)
# ─────────────────────────────────────────────────────────────────────

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ─────────────────────────────────────────────────────────────────
    # DNS resolver — REQUIRED so nginx does not crash at startup when
    # the backend hostname (BACKEND_URL) is not yet resolvable. Without
    # this, nginx tries to resolve the upstream once at config-load time
    # and exits with: `host not found in upstream`.
    #
    # 127.0.0.11 = embedded Docker DNS (works in Coolify/Compose/Swarm).
    # We also fall back to public resolvers so external hostnames
    # (e.g. api.yourdomain.com pointing at a separate service) resolve
    # even if the embedded DNS doesn't know them.
    #
    # `valid=` controls how long answers are cached; `ipv6=off` avoids
    # AAAA lookups when the host has no IPv6 (faster + fewer warnings).
    # ─────────────────────────────────────────────────────────────────
    resolver 127.0.0.11 1.1.1.1 8.8.8.8 valid=30s ipv6=off;
    resolver_timeout 5s;

    # Gzip compression. Build files under /assets/ are served from the
    # level-9 `.gz` copies the build writes (gzip_static, below); this
    # on-the-fly gzip covers everything else (index.html, JSON, widget files).
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;

    # ─────────────────────────────────────────────────────────────────
    # Optional /api/ reverse proxy to backend.
    # The frontend normally calls the backend directly via VITE_API_BASE_URL,
    # but exposing /api/ here lets same-origin deploys work too.
    # BACKEND_URL is substituted at container start by envsubst.
    #
    # IMPORTANT: we assign BACKEND_URL to a `set` variable and use it in
    # `proxy_pass`. This forces nginx to resolve the hostname at REQUEST
    # time (via the `resolver` above) instead of at startup, so the
    # container boots even if the backend DNS isn't ready yet.
    #
    # The `proxy_pass` value must be the bare origin, with no URI part: when
    # it holds a variable, a URI part (`$backend_url/api/`) REPLACES the whole
    # request path, so every request reached Express as `GET /api/` and got
    # its `{"error":"Not found"}` (e.g. the Super Admin's "login as user"
    # link, which is built on this host). Without one, nginx forwards the
    # original path and query string unchanged.
    # ─────────────────────────────────────────────────────────────────
    location /api/ {
        set $backend_url "${BACKEND_URL}";
        proxy_pass $backend_url;
        proxy_http_version 1.1;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_ssl_server_name on;
        proxy_read_timeout 300s;
        proxy_connect_timeout 60s;
    }

    # ─────────────────────────────────────────────────────────────────
    # Runtime deployment config — NEVER cache. Lets an operator point the
    # dashboard at a different API domain by editing/mounting this one file
    # (no rebuild). Empty apiBaseUrl = same-origin via the /api/ proxy above.
    # ─────────────────────────────────────────────────────────────────
    location = /runtime-config.js {
        root /usr/share/nginx/html;
        types { } default_type application/javascript;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        try_files /runtime-config.js =404;
    }

    # ─────────────────────────────────────────────────────────────────
    # PWA service worker — NEVER cache. A stale cached sw.js is one of the
    # most common PWA bugs: it would keep re-installing an old worker (and
    # therefore an old precache list) after every deploy. The same rule
    # applies to Workbox's own generated runtime-registration file.
    # ─────────────────────────────────────────────────────────────────
    location = /sw.js {
        root /usr/share/nginx/html;
        types { } default_type application/javascript;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        try_files /sw.js =404;
    }
    location = /registerSW.js {
        root /usr/share/nginx/html;
        types { } default_type application/javascript;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files /registerSW.js =404;
    }

    # ─────────────────────────────────────────────────────────────────────
    # Widget assets — MUST be served as static files. Never fall back to
    # index.html, otherwise the loader receives the SPA HTML instead of
    # widget-manifest.json / runtime JS and customers load a broken widget.
    # ─────────────────────────────────────────────────────────────────────

    # Widget loader — never served stale, so widget config/domain changes apply
    # on the very next page view.
    location = /widget/loader.js {
        root /usr/share/nginx/html;
        # Explicit script content-type so Firefox ORB / Chrome CORB do not
        # block this third-party script when the host page is on another
        # origin. Without an explicit type, nginx's MIME guess + the global
        # `X-Content-Type-Options: nosniff` can produce an
        # "OpaqueResponseBlocking" failure where the script never runs.
        types { } default_type application/javascript;
        expires -1;
        # `no-cache` (not `no-store`): the browser may keep a copy but must
        # revalidate it on EVERY use, so freshness is exactly what `no-store`
        # gave. The difference is cost: an unchanged loader now answers the
        # revalidation (ETag / Last-Modified) with a bodiless 304 instead of
        # the full ~150 KB file on every page view of every embedding site.
        # A new deploy changes the ETag, so the next page view gets a 200.
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header X-Widget-Asset "loader" always;
        add_header Access-Control-Allow-Origin "*" always;
        # CORP must be cross-origin so browsers (Firefox ORB / Safari) allow
        # this asset to be loaded as a script from a third-party origin.
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        # Force Cloudflare (and any CDN that honors these headers) to bypass
        # cache. Without this, CF can still cache based on its own Cache
        # Rules / default policy. These apply to shared caches only; the
        # browser still keeps its revalidated copy per the line above.
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        try_files /widget/loader.js =404;
    }

    # Widget manifest — never cache, must always return JSON (or 404). Never HTML.
    location = /widget/widget-manifest.json {
        root /usr/share/nginx/html;
        default_type application/json;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Widget-Asset "manifest" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        # See note above — Cloudflare-aware cache bypass.
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        try_files /widget/widget-manifest.json =404;
    }

    # All other widget assets (hashed runtime js/css) — immutable long cache.
    # Uses regex prefix so it wins over the SPA fallback `location /`.
    #
    # ─── WIDGET-FONT-CORS (post-mortem) ──────────────────────────────
    # Symptom: customer pages logged "CORS error" for
    # /widget/fonts/iransans-*.woff2 even though this block sets
    # `Access-Control-Allow-Origin: *`. The origin config was correct —
    # the responses customers received did not come from this block:
    #   1. .woff2 is in the CDN's default "cache everything by extension"
    #      list. Copies fetched BEFORE the ACAO header was added here were
    #      still being served from the edge, header-less. `CDN-Cache-Control`
    #      / `Cloudflare-CDN-Cache-Control` (set below) are honoured only on
    #      Enterprise plans, so origin `no-store` did not evict them.
    #   2. `/widget/fonts/` is not content-addressed, so the stale edge copy
    #      never rotated on deploy — unlike hashed assets.
    # Fix (architectural, not a workaround): every face is a CONTENT-HASHED
    # file, /widget/fonts/<name>.<hash>.woff2 (scripts/widget-hash.js), named
    # by the content-hashed presentation-<id>-fonts.css and served by the
    # hashed branch below, with `Access-Control-Allow-Origin: *` from its very
    # first response. Any byte change is a new URL, so no edge can hold a copy
    # that predates a header (cause 2), and none has ever seen these URLs
    # without it (cause 1). (Between the incident and this, the faces were
    # inlined as data: URLs in that stylesheet: ~231 KB gzip on every first
    # open, for faces most visitors never draw.) The unhashed
    # /widget/fonts/*.woff2 are dev sources only; nothing in production names
    # them. If one is ever served again, purge the CDN cache for it after any
    # header change.
    # ─────────────────────────────────────────────────────────────────
    location ^~ /widget/ {
        root /usr/share/nginx/html;
        # NOTE: do NOT add CORS headers here. nginx `add_header` APPENDS, and
        # this block already sets them below for the unhashed branch — having
        # them in both places emitted `Access-Control-Allow-Origin: *, *`,
        # which browsers reject ("contains multiple values"). That is exactly
        # what blocked /widget/fonts/*.woff2 on customer pages. Each leaf
        # branch owns its own CORS headers.



        # ─────────────────────────────────────────────────────────────
        # Cache policy split:
        #   • Hashed assets  (e.g. runtime.4f424b04.css)  → immutable 1y
        #   • Unhashed assets (e.g. runtime.css)           → no-store
        #
        # WHY: Both `public/widget/runtime.css` (unhashed, dev-only) and
        # `dist/widget/runtime.HASH.css` (hashed, prod) end up under
        # /usr/share/nginx/html/widget/. If we cache the UNHASHED file
        # for a year, any request that ever falls back to it (because
        # the backend manifest was stale or a host CDN cached a stale
        # config) will pin the OLD widget styles for that user for a
        # full year. That was the exact symptom: "sometimes the old
        # style appears." We now refuse to long-cache unhashed runtime
        # files — only the content-addressed ones get immutable.
        # ─────────────────────────────────────────────────────────────
        location ~* "^/widget/.*\.[a-f0-9]{8}\.(?:js|css|woff2)$" {
            root /usr/share/nginx/html;
            # Force MIME so Firefox ORB / Chrome CORB cannot mis-classify
            # the response and refuse to execute it as a script.
            types {
                application/javascript js;
                text/css              css;
                font/woff2            woff2;
            }
            # One Cache-Control, and no `always` on it: a year-long header must
            # never ride on an error (see /assets/ below). A hashed file this
            # container does not have (the other container's build during a
            # rolling deploy) is a 404 that nothing stores.
            # `expires off`: this block would otherwise inherit the parent's
            # `expires -1`, which adds `Expires` and a second
            # `Cache-Control: no-cache` next to this one, and browsers then
            # revalidate a file whose name is its content on every use.
            expires off;
            # scripts/widget-hash.js writes a level-9 `<file>.gz` beside each
            # hashed script and stylesheet: sent as is, never gzipped again.
            gzip_static on;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Widget-Asset "runtime-hashed" always;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Cross-Origin-Resource-Policy "cross-origin" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            try_files $uri @missing_widget_asset;
        }

        # Unhashed runtime/css/js fallbacks — never cache. If any client
        # ever loads these by accident, we want them to re-validate next
        # time so a fresh deploy converges.
        types {
            application/javascript js;
            text/css              css;
            application/json      json;
            font/woff2            woff2;
            font/woff             woff;
        }
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        add_header X-Widget-Asset "runtime-unhashed" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        # Hard 404 — DO NOT fall back to index.html for /widget/* paths.
        try_files $uri =404;
    }

    # A hashed widget file this image does not have (the hashed branches of
    # /widget/ above and /call-widget/ below): a 404 no browser or edge
    # keeps, readable cross-origin.
    location @missing_widget_asset {
        add_header Cache-Control "no-store" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 404;
    }

    # ─────────────────────────────────────────────────────────────────────
    # WooCommerce plugin download + its update manifest.
    #
    # These two files are read as a PAIR: webyar-woocommerce.json advertises
    # a version and the installed plugin then downloads the .zip beside it.
    # They live at fixed paths, so whatever an edge holds is what every store
    # gets until it expires — and Cloudflare caches a .zip by default while
    # leaving a .json alone, which makes the pair disagree: the manifest
    # announces a release the archive does not contain yet. WordPress then
    # installs the OLD build, still reads the old version afterwards, and —
    # with auto-updates on — tries again on every cron run.
    #
    # So neither is cached anywhere. This is a once-a-release download; the
    # bytes saved are worth nothing next to shipping the wrong plugin.
    # ─────────────────────────────────────────────────────────────────────
    location ^~ /downloads/ {
        root /usr/share/nginx/html;
        # Named here because a `types` block replaces nginx's whole table for
        # this location, so every kind of file the folder holds is listed:
        # the Android app (served as `application/octet-stream` without this,
        # which some phones' browsers will not offer to install), the plugin
        # zips, and their manifests. Anything else stays octet-stream.
        types {
            application/vnd.android.package-archive apk;
            application/zip zip;
            application/json json;
        }
        default_type application/octet-stream;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        # Cloudflare honours these even where it ignores Cache-Control.
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        # Hard 404 — a store must never receive the SPA's index.html and try
        # to unzip it.
        try_files $uri =404;
    }

    # ─────────────────────────────────────────────────────────────────────
    # The panel's build output (dist/assets). Every file name carries a hash
    # of its content (index-<hash>.js, vendor-react-<hash>.js, one file per
    # page, fonts, CSS), so a given URL never changes: browsers and
    # Cloudflare keep it for a year and never ask again (`immutable`). A
    # deploy changes the names, and index.html (no-cache, below) points at
    # the new ones.
    #
    # One Cache-Control header only: the previous `expires 30d` +
    # `add_header Cache-Control "public, immutable"` sent two of them.
    # No `always` on it: a year-long header must never ride on an error.
    #
    # gzip_static: the build writes a level-9 `<file>.gz` beside each script
    # and stylesheet (scripts/build/precompress.mjs); nginx sends it as-is to
    # clients that accept gzip instead of compressing on every request.
    # `^~`: a prefix match that no regex location can take over.
    # ─────────────────────────────────────────────────────────────────────
    location ^~ /assets/ {
        root /usr/share/nginx/html;
        gzip_static on;
        add_header Cache-Control "public, max-age=31536000, immutable";
        # A missing file is a hard 404 (never the SPA's index.html), from
        # @missing_asset below.
        try_files $uri @missing_asset;
    }

    # A build file this image does not have: a page file an older build
    # asked for, or a newer one during a rolling deploy, when the old and the
    # new container both take requests. The 404 must not be stored anywhere
    # (browser, Cloudflare, the service worker): the same URL may exist a
    # moment later on the other container, and a stored 404 for the entry
    # script would blank the panel for everyone behind that cache. It fails
    # as a script load, which the app handles (src/lib/perf/chunkReload.ts).
    location @missing_asset {
        add_header Cache-Control "no-store" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 404;
    }

    # ─────────────────────────────────────────────────────────────────────
    # The SPA document. `no-cache` = the browser may keep it but must
    # revalidate (ETag → 304) on every load, so a deploy is picked up at the
    # next navigation and the hashed file names it lists are always current.
    # Without a header the browser was free to reuse a stale copy
    # heuristically — which would point at page files a deploy removed.
    # Every SPA route reaches this block through the `location /` fallback.
    # The security headers are repeated: nginx drops server-level
    # `add_header`s in a location that sets its own.
    # ─────────────────────────────────────────────────────────────────────
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files /index.html =404;
    }

    # ─────────────────────────────────────────────────────────────────────
    # Call Center widget. A customer's snippet names /call-widget/l.js, so
    # that path is fixed; every other file is content-addressed by
    # scripts/call-widget-hash.js, which writes the names INTO l.js: one
    # image, one build, so a loader can never name another deploy's file.
    #   • hashed files (`<name>.<12 hex>.js|css`) → immutable, a year, from
    #     the level-9 .gz copies the build writes. (The LiveKit SDK l.js names
    #     is the chat widget's hashed copy under /widget/vendor/.)
    #   • l.js and the fixed names (older loaders, the operator preview,
    #     the loader's own fallback) → `no-cache`: the browser keeps them but
    #     revalidates on every use (ETag → bodiless 304), a CDN never stores
    #     them — exactly /widget/loader.js's policy.
    #   • vendor/ (the SDK at its fixed name, for older loaders and the
    #     fallback) → a year, as before.
    # History: everything here used to be no-store, plus a per-load
    # `&t=Date.now()` in l.js, after "some browsers show the new widget,
    # others the old one even after a CF cache purge" — fixed names that had
    # no Cache-Control picked up heuristic browser caching and Cloudflare's
    # edge TTL. A content-addressed name cannot be stale, and l.js is never
    # reused unrevalidated, so that cannot come back; every page view no
    # longer re-downloads the whole UI.
    # No `expires` at this level: nested locations inherit it (both nested
    # blocks also say `expires off`). A miss in either is a 404 nothing
    # stores (@missing_widget_asset).
    # ─────────────────────────────────────────────────────────────────────
    location ^~ /call-widget/ {
        root /usr/share/nginx/html;
        types {
            application/javascript js;
            text/css              css;
            application/json      json;
        }

        location ~* "^/call-widget/[a-z0-9.-]+\.[a-f0-9]{12}\.(?:js|css)$" {
            root /usr/share/nginx/html;
            types {
                application/javascript js;
                text/css              css;
            }
            gzip_static on;
            # One Cache-Control, and no `always` on it: a year-long header
            # never rides on an error. `expires off` keeps it the only one
            # even if this block's parent ever sets `expires` again (nested
            # locations inherit it; `expires -1` adds `Expires` and a second
            # `Cache-Control: no-cache`).
            expires off;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header Access-Control-Allow-Origin "*" always;
            add_header Cross-Origin-Resource-Policy "cross-origin" always;
            add_header X-Widget-Asset "call-widget-hashed" always;
            # Another build's name (a stale loader, or the other container
            # during a rolling deploy): a 404 nothing stores, readable
            # cross-origin (@missing_widget_asset); the loader then falls back
            # to the fixed names, which every build has.
            try_files $uri @missing_widget_asset;
        }

        # The media SDK at its fixed name: loaders from before hashing, and
        # l.js when the chat widget's hashed copy is not there. Pinned to
        # one upstream version, so a year; one Cache-Control (`expires off`),
        # never on an error (no `always`), and a miss is not kept.
        location ~* "^/call-widget/vendor/" {
            root /usr/share/nginx/html;
            expires off;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header Access-Control-Allow-Origin "*" always;
            add_header Cross-Origin-Resource-Policy "cross-origin" always;
            try_files $uri @missing_widget_asset;
        }

        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header X-Widget-Asset "call-widget" always;
        try_files $uri =404;
    }

    # SPA fallback — only for non-widget paths
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
