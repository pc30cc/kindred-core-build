# WEBYAR backup agent configuration.
# Copy to backup.env and fill in on the host. NEVER commit the filled copy and
# never bake these values into an image.

# ── Interlock (fail closed) ─────────────────────────────────────────────────
# Every script exits 78 ("NOT READY") unless this is exactly 1. Only set it
# after the blocking corrections in docs/BACKUP_AND_DISASTER_RECOVERY.md are
# resolved and an isolated restore has been proven on this infrastructure.
WEBYAR_BACKUP_ENABLED=0

# ── PostgreSQL (read-only backup role is enough for logical dumps) ──────────
PGHOST=db
PGPORT=5432
PGUSER=webyar_backup
PGPASSWORD=
PGDATABASE=postgres
# Physical backups additionally need the data directory:
PGDATA=/var/lib/postgresql/data

# ── Off-site object storage (DEDICATED backup bucket, never user uploads) ───
# Credentials must be a backup-only key: PutObject + GetObject + ListBucket.
# It must NOT have DeleteObject on the backup prefix — expiry is done by a
# bucket lifecycle rule / object-lock policy, not by the production server.
WALG_S3_PREFIX=s3://webyar-backups/postgres
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=https://s3.example-region.backblazeb2.com
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true

# ── Encryption (client-side; the bucket's own SSE is an additional layer) ───
# Age or libsodium key managed by WAL-G. Keep the private key OUT of this host
# where possible — restoring must be possible after losing the server.
WALG_LIBSODIUM_KEY_TRANSFORM=none
WALG_LIBSODIUM_KEY=
# Passphrase used by logical-backup.sh (openssl enc -aes-256-cbc -pbkdf2):
BACKUP_ENCRYPTION_PASSPHRASE=

# ── Compression / tuning ────────────────────────────────────────────────────
WALG_COMPRESSION_METHOD=zstd
WALG_UPLOAD_CONCURRENCY=4
WALG_DELTA_MAX_STEPS=6

# ── Retention (enforced through WAL-G, which never deletes a base backup that
#    retained WAL still depends on) ───────────────────────────────────────────
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# ── Reporting back to the WEBYAR app ────────────────────────────────────────
WEBYAR_API_BASE=https://app.example.com
BACKUP_AGENT_TOKEN=

# ── Object storage (MinIO / Supabase Storage) mirror ────────────────────────
MINIO_ALIAS=production
MINIO_BACKUP_ALIAS=offsite
MINIO_BUCKETS=storage
