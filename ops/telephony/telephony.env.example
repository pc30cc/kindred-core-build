# WEBYAR Telephony — deployment environment.
# Copy to .env next to docker-compose.telephony.yml. Never commit real values.

# ── Core ↔ Telephony Control Service ────────────────────────────────────────
# Dedicated secret. Do NOT reuse CORE_INTERNAL_SECRET or any AI/channel secret.
# Set the SAME value as TELEPHONY_INTERNAL_SECRET in the Core environment.
TELEPHONY_INTERNAL_SECRET=change-me-long-random
# Internal base URL of Core, reachable from this container.
TELEPHONY_CORE_BASE_URL=http://webyar-core:3000
# Core side: TELEPHONY_INTERNAL_BASE_URL=http://webyar-telephony:8089

# ── Public SIP identity (NAT) ───────────────────────────────────────────────
TELEPHONY_PUBLIC_SIP_HOST=sip.your-domain.example
TELEPHONY_SIP_PORT=5060
TELEPHONY_SIP_TLS_PORT=5061
TELEPHONY_RTP_PORT_MIN=16384
TELEPHONY_RTP_PORT_MAX=16584

# ── Asterisk ARI (runtime call control only, never published) ───────────────
ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USER=webyar
ASTERISK_ARI_PASSWORD=change-me-long-random
ASTERISK_ARI_APP=webyar

# ── PJSIP Realtime database ─────────────────────────────────────────────────
# Least-privilege login mapped to the restricted `asterisk` schema created by
# database/migrations/200_telephony_foundation.sql. NOT the application role.
ASTERISK_DB_URL=postgresql://webyar_asterisk:change-me@postgres:5432/webyar
ASTERISK_DB_SCHEMA=asterisk

# ── LiveKit + LiveKit SIP (REQUIRED media path) ─────────────────────────────
LIVEKIT_URL=wss://livekit.your-domain.example
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_REDIS_ADDRESS=redis:6379
LIVEKIT_SIP_URI=livekit-sip:5080
LIVEKIT_SIP_TRUNK_NAME=webyar-inbound-trunk
LIVEKIT_SIP_DISPATCH_NAME=webyar-callee-dispatch
LIVEKIT_SIP_RTP_MIN=20000
LIVEKIT_SIP_RTP_MAX=20100

# Existing external Docker network shared with Core/LiveKit/Redis.
WEBYAR_NETWORK=webyar
