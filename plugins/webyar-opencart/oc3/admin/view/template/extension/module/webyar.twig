{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-webyar" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ back }}" data-toggle="tooltip" title="{{ button_back }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div id="webyar-alert"></div>
    {% if not supported %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ text_unsupported }}</div>{% endif %}
    {% if not key_ok %}<div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ error_storage }}</div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-shopping-cart"></i> {{ text_stores }}</h3></div>
      <div class="panel-body">
        <p class="text-muted">{{ help_stores }}</p>
        <div class="table-responsive">
          <table class="table table-bordered">
            <thead><tr><th>{{ column_store }}</th><th>{{ column_status }}</th><th class="text-center">{{ column_widget }}</th><th class="text-right">{{ column_action }}</th></tr></thead>
            <tbody>
              {% for store in stores %}
              <tr>
                <td><strong>{{ store.name }}</strong><br/><small class="text-muted">{{ store.url }}</small> <span class="label label-default">#{{ store.store_id }}</span></td>
                <td>
                  {% if store.connected %}
                    <span class="label label-success">{{ text_connected }}</span><br/><small class="text-muted">{{ text_workspace }}: <code>{{ store.workspace_id }}</code><br/>{{ text_paired_at }}: {{ store.paired_at }}</small>
                  {% else %}
                    <span class="label label-default">{{ text_not_connected }}</span>{% if not store.https %}<br/><small class="text-danger">{{ error_https }}</small>{% endif %}
                  {% endif %}
                </td>
                <td class="text-center">
                  <input type="hidden" name="widget[{{ store.store_id }}]" value="0" form="form-webyar"/>
                  <input type="checkbox" name="widget[{{ store.store_id }}]" value="1" form="form-webyar"{% if store.widget %} checked{% endif %}/>
                </td>
                <td class="text-right">
                  {% if store.connected %}
                    <button type="button" class="btn btn-default btn-sm webyar-action" data-action="{{ test }}" data-store="{{ store.store_id }}">{{ button_test }}</button>
                    <button type="button" class="btn btn-default btn-sm webyar-action" data-action="{{ connect }}" data-store="{{ store.store_id }}">{{ button_reconnect }}</button>
                    <button type="button" class="btn btn-danger btn-sm webyar-action" data-action="{{ disconnect }}" data-store="{{ store.store_id }}" data-confirm="{{ text_confirm_disconnect }}">{{ button_disconnect }}</button>
                  {% else %}
                    <button type="button" class="btn btn-primary btn-sm webyar-action" data-action="{{ connect }}" data-store="{{ store.store_id }}"{% if not store.https %} disabled{% endif %}>{{ button_connect }}</button>
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form id="form-webyar" action="{{ save }}" method="post" class="form-horizontal">
          <input type="hidden" name="webyar_csrf" value="{{ csrf }}"/>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_status }}</label>
            <div class="col-sm-9"><input type="hidden" name="module_webyar_status" value="0"/><input type="checkbox" name="module_webyar_status" value="1"{% if module_webyar_status %} checked{% endif %}/></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-app">{{ entry_app_url }}</label>
            <div class="col-sm-9"><input type="url" name="module_webyar_app_url" value="{{ module_webyar_app_url }}" id="input-app" class="form-control" placeholder="https://"/><span class="help-block">{{ help_app_url }}</span></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-api">{{ entry_api_url }}</label>
            <div class="col-sm-9"><input type="url" name="module_webyar_api_url" value="{{ module_webyar_api_url }}" id="input-api" class="form-control" placeholder="https://"/><span class="help-block">{{ help_api_url }}</span></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_orders }}</label>
            <div class="col-sm-9"><input type="hidden" name="module_webyar_orders" value="0"/><input type="checkbox" name="module_webyar_orders" value="1"{% if module_webyar_orders %} checked{% endif %}/><span class="help-block">{{ help_orders }}</span></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_reviews }}</label>
            <div class="col-sm-9"><input type="hidden" name="module_webyar_reviews" value="0"/><input type="checkbox" name="module_webyar_reviews" value="1"{% if module_webyar_reviews %} checked{% endif %}/></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-scope">{{ entry_customer_scope }}</label>
            <div class="col-sm-9">
              <select name="module_webyar_customer_scope" id="input-scope" class="form-control">
                <option value="installation"{% if module_webyar_customer_scope == 'installation' %} selected{% endif %}>{{ text_scope_installation }}</option>
                <option value="registration_store"{% if module_webyar_customer_scope == 'registration_store' %} selected{% endif %}>{{ text_scope_registration }}</option>
              </select>
              <span class="help-block">{{ help_customer_scope }}</span>
            </div>
          </div>
          <p class="text-muted small">{{ text_version }} {{ version }} · OpenCart {{ oc_version }}</p>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
(function ($) {
  function show(json) {
    if (json.redirect) { location = json.redirect; return; }
    var kind = json.error ? 'danger' : 'success';
    $('#webyar-alert').html($('<div class="alert"/>').addClass('alert-' + kind).text(json.error || json.success || ''));
  }
  function post(url, data) {
    $.ajax({ url: url, type: 'post', data: data, dataType: 'json' }).done(show).fail(function () { show({ error: 'Request failed' }); });
  }
  $('#form-webyar').on('submit', function (e) { e.preventDefault(); post(this.action, $(this).serialize() + '&' + $('input[form="form-webyar"]').serialize()); });
  $('.webyar-action').on('click', function () {
    var b = $(this);
    if (b.data('confirm') && !confirm(b.data('confirm'))) { return; }
    post(b.data('action'), { store_id: b.data('store'), webyar_csrf: '{{ csrf }}' });
  });
})(jQuery);
//--></script>
{{ footer }}
