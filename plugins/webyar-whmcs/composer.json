{
  "name": "webyar/webyar-whmcs",
  "description": "Dev tooling only — the addon itself has zero runtime Composer dependencies; it uses what WHMCS provides.",
  "type": "project",
  "license": "proprietary",
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "illuminate/database": "^8.83",
    "squizlabs/php_codesniffer": "^3.10",
    "phpcompatibility/php-compatibility": "^9.3"
  },
  "config": {
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }
  }
}
