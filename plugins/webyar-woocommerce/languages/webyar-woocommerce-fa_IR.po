msgid "API URL"
msgstr "آدرس API"

msgid "Advanced settings"
msgstr "تنظیمات پیشرفته"

msgid "Chat widget"
msgstr "ویجت گفتگو"

msgid "Configure the widget in the WebYar dashboard."
msgstr "ظاهر و رفتار ویجت از داشبورد وب‌یار تنظیم می‌شود."

msgid "Connect to WebYar"
msgstr "اتصال به وب‌یار"

msgid "Connect your WooCommerce store to WebYar for product answers, order status, and shipment tracking."
msgstr "فروشگاه ووکامرس را برای پاسخ‌گویی درباره محصولات، سفارش‌ها و رهگیری به وب‌یار متصل کنید."

msgid "Connect your store"
msgstr "اتصال فروشگاه"

msgid "Connect your store to WebYar to answer customers using your products, prices, stock, and orders."
msgstr "فروشگاه را متصل کنید تا دستیار بر اساس محصول، قیمت، موجودی و سفارش پاسخ دهد."

msgid "Connected at"
msgstr "زمان اتصال"

msgid "Connected to WebYar."
msgstr "به وب‌یار متصل شدید."

msgid "Connection credentials rejected"
msgstr "اعتبارنامه پذیرفته نمی‌شود"

msgid "Connection test requested."
msgstr "درخواست تست اتصال ارسال شد."

msgid "Could not connect to %1$s: %2$s"
msgstr "اتصال به %1$s برقرار نشد: %2$s"

msgid "Could not finish connecting to WebYar: %s"
msgstr "اتصال به وب‌یار برای تکمیل فرآیند برقرار نشد: %s"

msgid "Could not reach WebYar: %s"
msgstr "ارتباط با وب‌یار برقرار نشد: %s"

msgid "Disconnect"
msgstr "قطع اتصال"

msgid "Disconnect this store from WebYar?"
msgstr "اتصال این فروشگاه به وب‌یار قطع شود؟"

msgid "Disconnected from WebYar."
msgstr "اتصال به وب‌یار قطع شد."

msgid "Enter a valid API URL or leave the field empty."
msgstr "آدرس API معتبر نیست. یا یک آدرس درست وارد کنید یا خالی بگذارید."

msgid "Enter a valid WebYar URL before connecting (for example, https://app.webyar.ai)."
msgstr "پیش از اتصال، یک آدرس معتبر وب‌یار وارد کنید (مثلاً https://app.webyar.ai)."

msgid "Enter the WebYar URL before connecting."
msgstr "پیش از اتصال، آدرس وب‌یار را در پایین وارد کنید."

msgid "Enter this only if the WebYar API has a separate URL. Otherwise leave it empty."
msgstr "فقط اگر API وب‌یار روی دامنه‌ی جداگانه‌ای سرو می‌شود این را پر کنید. خالی بگذارید تا همان آدرس بالا استفاده شود."

msgid "Failed events (latest 50)"
msgstr "رویدادهای ناموفق (۵۰ مورد اخیر)"

msgid "Invalid connection callback."
msgstr "بازگشت نامعتبر از فرآیند اتصال."

msgid "Manage products, prices, stock, orders, permissions, and sync in WebYar under Integrations > Store."
msgstr "کاتالوگ محصولات، قیمت‌گذاری، موجودی، سفارش‌ها، سطوح دسترسی و وضعیت همگام‌سازی از داشبورد وب‌یار، در بخش یکپارچه‌سازی‌ها ← فروشگاه، مدیریت می‌شوند."

msgid "Not available"
msgstr "نامشخص"

msgid "Plugin version"
msgstr "نسخه‌ی افزونه"

msgid "Product sync requested."
msgstr "درخواست همگام‌سازی ارسال شد."

msgid "Protocol version"
msgstr "نسخه‌ی پروتکل"

msgid "Reason"
msgstr "دلیل"

msgid "Same as dashboard"
msgstr "همان داشبورد"

msgid "Save"
msgstr "ذخیره"

msgid "Settings saved."
msgstr "تنظیمات ذخیره شد."

msgid "Show the chat widget in the store"
msgstr "نمایش ویجت گفتگو در فروشگاه"

msgid "Store"
msgstr "فروشگاه"

msgid "Store connected"
msgstr "فروشگاه متصل است"

msgid "Sync products"
msgstr "همگام‌سازی محصولات"

msgid "Technical details"
msgstr "جزئیات فنی"

msgid "Technical details: %d failed events"
msgstr "جزئیات فنی: %d رویداد ناموفق"

msgid "Test connection"
msgstr "تست اتصال"

msgid "The URL you use to sign in to WebYar."
msgstr "همان آدرسی که با آن وارد حساب وب‌یار خود می‌شوید."

msgid "The connection request did not match. Please try again."
msgstr "عدم تطابق در فرآیند اتصال: لطفاً دوباره تلاش کنید."

msgid "The connection request expired. Please try again."
msgstr "زمان درخواست اتصال به پایان رسید: لطفاً دوباره تلاش کنید."

msgid "The store is not connected to WebYar."
msgstr "فروشگاه به وب‌یار متصل نیست."

msgid "Time"
msgstr "زمان"

msgid "Type"
msgstr "نوع"

msgid "WebYar"
msgstr "وب‌یار"

msgid "WebYar URL"
msgstr "آدرس وب‌یار"

msgid "WebYar dashboard"
msgstr "داشبورد وب‌یار"

msgid "WebYar for WooCommerce"
msgstr "وب‌یار برای ووکامرس"

msgid "WebYar for WooCommerce does not support network activation. Activate it separately on each site."
msgstr "افزونه‌ی اتصال‌دهنده‌ی وب‌یار برای ووکامرس از فعال‌سازی شبکه‌ای پشتیبانی نمی‌کند. لطفاً آن را به‌صورت جداگانه در هر سایت فعال کنید."

msgid "WebYar for WooCommerce requires PHP 7.4+, WordPress 6.0+, and active WooCommerce 8.0+. The plugin stays inactive until these requirements are met."
msgstr "افزونه‌ی اتصال‌دهنده‌ی وب‌یار برای ووکامرس نیاز به PHP نسخه‌ی ۷.۴ به بالا، وردپرس ۶.۰ به بالا و ووکامرس ۸.۰ به بالا (فعال) دارد. تا زمانی که این پیش‌نیازها فراهم نشوند، افزونه غیرفعال می‌ماند: فروشگاه شما تحت تأثیر قرار نمی‌گیرد."

msgid "WebYar rejected the connection confirmation."
msgstr "وب‌یار درخواست نهایی‌سازی اتصال را رد کرد."

msgid "WebYar rejected the connection request (code %1$d) at %2$s. Check the URL and try again."
msgstr "وب‌یار درخواست اتصال را رد کرد (کد %1$d) در آدرس %2$s. بررسی کنید آدرس وب‌یار درست و در دسترس باشد."

msgid "WebYar rejected the last signed request with code %1$d at %2$s. Disconnect and reconnect your store."
msgstr "وب‌یار آخرین درخواست امضاشده را با کد %1$d رد کرد (%2$s). معمولاً یعنی کلید اتصال در وب‌یار چرخانده یا باطل شده: یک بار «قطع اتصال» و دوباره «اتصال به وب‌یار» را بزنید."

msgid "WebYar rejected this request (code %d)."
msgstr "وب‌یار این درخواست را رد کرد (کد %d)."

msgid "WebYar rejected this store’s credentials. Disconnect and reconnect the store."
msgstr "وب‌یار اعتبارنامه‌ی این فروشگاه را نپذیرفت. یک بار «قطع اتصال» و دوباره «اتصال به وب‌یار» را بزنید."

msgid "You cannot access this page."
msgstr "شما اجازه‌ی دسترسی به این صفحه را ندارید."

msgid "You cannot manage the WebYar connection."
msgstr "شما اجازه‌ی مدیریت اتصال وب‌یار را ندارید."

msgid "Your WebYar server does not support this action. Update WebYar."
msgstr "نسخه‌ی وب‌یار شما این درخواست را پشتیبانی نمی‌کند. سرور وب‌یار را به‌روز کنید."

msgid "Your store assistant"
msgstr "دستیار هوش مصنوعی فروشگاه شما"

