# Server Environment Variables
# Copy this to .env and fill in the values

# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (required in production)
SESSION_SECRET=generate-a-strong-random-secret-here
APP_URL=https://your-domain.com
APP_NAME=Growth Suite
SYSTEM_FROM_EMAIL=noreply@your-domain.com

# Optional
PORT=3001
NODE_ENV=production
CORS_ORIGINS=https://your-domain.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email — Resend (set if using Resend as email provider)
# RESEND_API_KEY=re_xxxxx

# Email — SendGrid (set if using SendGrid as email provider)
# SENDGRID_API_KEY=SG.xxxxx

# Email — SMTP (set if using SMTP as email provider)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-password
# SMTP_TLS_REJECT_UNAUTHORIZED=true
