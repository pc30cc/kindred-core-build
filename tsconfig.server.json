{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "./",
    "outDir": "./server/dist",
    "paths": { "*": ["./server/*"] },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false
  },
  "include": ["server/**/*.ts", "worker/**/*.ts", "channels/**/*.ts", "shared/**/*.ts", "runtime/**/*.ts", "ai-runtime/**/*.ts"],
  "exclude": ["server/node_modules", "server/dist", "node_modules"]
}