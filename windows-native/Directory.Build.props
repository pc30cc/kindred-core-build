<Project>
  <!-- Shared by every project in the native Windows app. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>Webyar</Company>
    <Product>Webyar</Product>
    <Copyright>Copyright © Webyar</Copyright>
    <!-- One version for the whole app; the release workflow checks the tag against it. -->
    <Version>2.0.0</Version>
  </PropertyGroup>
</Project>
