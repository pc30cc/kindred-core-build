<UserControl
    x:Class="Webyar.App.Controls.AudioPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        A voice note played in place, messenger style: a round play button, a
        waveform that fills as it plays (click anywhere on it to seek) and the
        time. Colours follow the bubble it sits in — see Outgoing.
    -->
    <Grid Width="272" Padding="6,6,14,6" ColumnSpacing="12" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button
            x:Name="PlayButton"
            Width="42"
            Height="42"
            Padding="0"
            CornerRadius="11"
            BorderThickness="0"
            Background="{ThemeResource BrandBrush}"
            Click="OnPlay">
            <Grid>
                <FontIcon x:Name="PlayGlyph" Glyph="&#xF5B0;" FontSize="15" Margin="2,0,0,0" Foreground="{ThemeResource OnBrandBrush}" />
                <ProgressRing x:Name="Loading" Width="20" Height="20" IsActive="False" Foreground="{ThemeResource OnBrandBrush}" />
            </Grid>
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <!-- Transparent background so the whole strip, gaps included, takes the click. -->
            <Grid x:Name="WaveHost" Height="28" Background="Transparent" PointerPressed="OnWavePressed">
                <StackPanel x:Name="Wave" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
            </Grid>
            <Grid>
                <TextBlock x:Name="TimeText" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource Text3Brush}" Text="0:00" />
                <FontIcon x:Name="ErrorGlyph" HorizontalAlignment="Right" Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource DangerBrush}" Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
