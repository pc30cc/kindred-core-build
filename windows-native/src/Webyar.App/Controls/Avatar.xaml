<UserControl
    x:Class="Webyar.App.Controls.Avatar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Border x:Name="Disc" CornerRadius="999">
            <TextBlock
                x:Name="InitialsText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="White" />
        </Border>
        <Border x:Name="Photo" CornerRadius="999" Visibility="Collapsed">
            <Border.Background>
                <ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill" ImageFailed="OnImageFailed" />
            </Border.Background>
        </Border>
        <Ellipse
            x:Name="Presence"
            Width="10"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Stroke="{ThemeResource SurfaceBrush}"
            StrokeThickness="2"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
