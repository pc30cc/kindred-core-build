<UserControl
    x:Class="Webyar.App.Controls.CampaignCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
    <!--
        One ad from Super Admin → Desktop app, for the placement it is given:
        a round picture (or the megaphone), the title and text, the button,
        and ✕ when it may be closed. Collapsed when there is nothing to show.
    -->
    <Border x:Name="Card" Padding="12" CornerRadius="16" BorderThickness="1"
            BorderBrush="{ThemeResource BrandSoftBrush}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#142F6BFF" Offset="0" />
                <GradientStop Color="#0A7C4DDB" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{ThemeResource BrandSoftBrush}" />
                <FontIcon x:Name="Glyph" Glyph="&#xE789;" FontSize="18" Foreground="{ThemeResource BrandBrush}" />
                <Ellipse x:Name="Picture" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="PictureBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Padding="6,1,6,2" CornerRadius="8" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="AdBadge" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="BodyText" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" MinWidth="28" MinHeight="28" Padding="4" VerticalAlignment="Top" Click="OnClose">
                <FontIcon Glyph="&#xE711;" FontSize="10" />
            </Button>
            <Button x:Name="Cta" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Click="OnCta">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="CtaText" FontWeight="SemiBold" />
                    <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
