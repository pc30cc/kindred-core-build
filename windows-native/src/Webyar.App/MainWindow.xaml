<Window
    x:Class="Webyar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The product's own grey rather than Mica: white panels on it read the same on Windows 10 and 11. -->
    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Our own title bar: the window's content runs up under it, as in the Windows 11 apps. -->
        <Grid x:Name="TitleBarArea" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StartInset" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="EndInset" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />

        <!-- While the session is restored at launch. -->
        <StackPanel x:Name="Splash" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <ProgressRing IsActive="True" Width="36" Height="36" />
            <TextBlock x:Name="SplashText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
