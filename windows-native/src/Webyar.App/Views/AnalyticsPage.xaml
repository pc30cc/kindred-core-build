<Page
    x:Class="Webyar.App.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="SegToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </Page.Resources>

    <!--
        Website analytics, as the Mac app lays it out: on the left the title,
        who is on the site now, the date range every report shares and the
        reports to pick from; on the right the report picked, as cards.
    -->
    <Grid Padding="10" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="14,12,14,12" Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3B9BFF" Offset="0" />
                                    <GradientStop Color="#0070E0" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <FontIcon Glyph="&#xE9D2;" FontSize="17" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Name="SubtitleText" FontSize="11.5" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource Text2Brush}" />
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" Click="OnRefresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="15" />
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="R" Modifiers="Control" />
                                <KeyboardAccelerator Key="F5" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>

                    <!-- "12 on the site now", with a slow green pulse -->
                    <Border x:Name="LivePill" Visibility="Collapsed" Padding="10,6" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="18" Height="18">
                                <Ellipse x:Name="LivePulse" Width="18" Height="18" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="LivePulseScale" ScaleX="0.45" ScaleY="0.45" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="LiveDot" Width="8" Height="8" />
                            </Grid>
                            <TextBlock x:Name="LiveText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- The date range every report shares -->
                    <Grid x:Name="RangeBar" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="Range7" Style="{StaticResource SegToggle}" HorizontalAlignment="Stretch" Tag="7" Click="OnRange" />
                        <ToggleButton x:Name="Range28" Grid.Column="1" Style="{StaticResource SegToggle}" HorizontalAlignment="Stretch" Tag="28" IsChecked="True" Click="OnRange" />
                        <ToggleButton x:Name="Range90" Grid.Column="2" Style="{StaticResource SegToggle}" HorizontalAlignment="Stretch" Tag="90" Click="OnRange" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="1" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                    <ListView x:Name="SectionList" Padding="10" SelectionMode="Single" SelectionChanged="OnSection">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Grid>
        </Border>

        <!-- The report picked -->
        <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Background="{ThemeResource AppBackgroundBrush}">
            <Grid>
                <StackPanel x:Name="LockedState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="380">
                    <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Background="{ThemeResource WarningSoftBrush}">
                        <FontIcon Glyph="&#xE72E;" FontSize="22" Foreground="{ThemeResource WarningBrush}" />
                    </Border>
                    <TextBlock x:Name="LockedTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="LockedHint" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <ScrollViewer x:Name="DetailScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24" Spacing="16" MaxWidth="1080">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SectionTile" Width="36" Height="36" CornerRadius="11">
                                <FontIcon x:Name="SectionGlyph" FontSize="15" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="SectionTitle" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextBrush}" />
                                <TextBlock x:Name="SectionHint" FontSize="12" Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False">
                            <InfoBar.ActionButton>
                                <Button x:Name="RetryButton" Click="OnRefresh" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <StackPanel x:Name="TruncatedNote" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource Text2Brush}" />
                            <TextBlock x:Name="TruncatedText" FontSize="11.5" Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentControl x:Name="ReportHost" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" IsTabStop="False" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
