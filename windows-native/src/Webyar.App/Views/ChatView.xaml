<UserControl
    x:Class="Webyar.App.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Webyar.App.ViewModels"
    xmlns:h="using:Webyar.App.Helpers"
    xmlns:controls="using:Webyar.App.Controls"
    xmlns:views="using:Webyar.App.Views">
    <UserControl.Resources>

        <!--
            Files stand on their own, outside the text bubble, as in Telegram and
            WhatsApp: a photo is a rounded card, a voice note a pill in the
            sender's colour, any other file a card with a type tile.
        -->
        <DataTemplate x:Key="IncomingAttachmentTemplate" x:DataType="vm:AttachmentItem">
            <Grid HorizontalAlignment="Left">
                <Button Style="{StaticResource BubbleButtonStyle}" Padding="0" BorderThickness="0" Background="Transparent" CornerRadius="16" Visibility="{x:Bind ImageVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <Border CornerRadius="16" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" BorderThickness="1" Background="{ThemeResource ElevatedBrush}">
                        <Grid Width="{x:Bind PreviewWidth, Mode=OneWay}" Height="{x:Bind PreviewHeight, Mode=OneWay}">
                            <FontIcon Glyph="&#xEB9F;" FontSize="24" Foreground="{ThemeResource Text3Brush}" />
                            <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                </Button>
                <Border Visibility="{x:Bind AudioVisibility}" CornerRadius="27" Background="{ThemeResource BubbleIncomingBrush}" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" BorderThickness="1">
                    <controls:AudioPlayer Source="{x:Bind}" />
                </Border>
                <Button Style="{StaticResource BubbleButtonStyle}" Padding="0" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" Background="{ThemeResource BubbleIncomingBrush}" Visibility="{x:Bind FileVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <Grid Width="272" Padding="10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="11" Background="{ThemeResource BrandSoftBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource BrandBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SizeText}" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OutgoingAttachmentTemplate" x:DataType="vm:AttachmentItem">
            <Grid HorizontalAlignment="Right">
                <Button Style="{StaticResource BubbleButtonStyle}" Padding="0" BorderThickness="0" Background="Transparent" CornerRadius="16" Visibility="{x:Bind ImageVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <Border CornerRadius="16" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" BorderThickness="1" Background="{ThemeResource ElevatedBrush}">
                        <Grid Width="{x:Bind PreviewWidth, Mode=OneWay}" Height="{x:Bind PreviewHeight, Mode=OneWay}">
                            <FontIcon Glyph="&#xEB9F;" FontSize="24" Foreground="{ThemeResource Text3Brush}" />
                            <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                </Button>
                <Border Visibility="{x:Bind AudioVisibility}" CornerRadius="27" Background="{ThemeResource BubbleOutgoingBrush}">
                    <controls:AudioPlayer Source="{x:Bind}" Outgoing="True" />
                </Border>
                <Button Style="{StaticResource BubbleButtonStyle}" Padding="0" CornerRadius="14" BorderThickness="0" Background="{ThemeResource BubbleOutgoingBrush}" Visibility="{x:Bind FileVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <Grid Width="272" Padding="10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="11" Background="#33FFFFFF">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind FileName}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SizeText}" FontSize="11.5" Foreground="{ThemeResource BubbleOutgoingMetaBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE896;" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="AttachmentPanel">
            <StackPanel Spacing="4" />
        </ItemsPanelTemplate>

        <!-- Visitor: on the left, with their avatar beside the last bubble of a run (the web thread). -->
        <DataTemplate x:Key="IncomingTemplate" x:DataType="vm:MessageItem">
            <Grid Margin="0,1" HorizontalAlignment="Left" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Avatar
                    Size="32"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    DisplayName="{x:Bind AvatarName, Mode=OneWay}"
                    Email="{x:Bind AvatarEmail, Mode=OneWay}"
                    Os="{x:Bind AvatarOs, Mode=OneWay}"
                    ImageUrl="{x:Bind AvatarUrl, Mode=OneWay}"
                    Visibility="{x:Bind AvatarVisibility, Mode=OneWay}" />
                <StackPanel Grid.Column="1" MaxWidth="540" Spacing="4" HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{x:Bind Attachments}" ItemTemplate="{StaticResource IncomingAttachmentTemplate}" ItemsPanel="{StaticResource AttachmentPanel}" Visibility="{x:Bind AttachmentsVisibility}" />
                    <Border Padding="14,9,14,10" HorizontalAlignment="Left" Background="{ThemeResource BubbleIncomingBrush}" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" BorderThickness="1" CornerRadius="18,18,18,6" Visibility="{x:Bind BodyVisibility}">
                        <StackPanel Spacing="6">
                            <Button Style="{StaticResource QuoteButtonStyle}" Visibility="{x:Bind QuoteVisibility, Mode=OneWay}" Click="OnQuoteClick" Tag="{x:Bind}">
                                <StackPanel Spacing="1">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}" Text="{x:Bind QuoteSender, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource Text2Brush}" Text="{x:Bind QuoteText, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" TextReadingOrder="DetectFromContent" />
                                </StackPanel>
                            </Button>
                            <TextBlock FontSize="14" LineHeight="23" IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" TextReadingOrder="DetectFromContent" TextAlignment="DetectFromContent" Foreground="{ThemeResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0,6,4" HorizontalAlignment="Left">
                        <TextBlock Margin="2,0,6,0" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Meta, Mode=OneWay}" Visibility="{x:Bind MetaVisibility, Mode=OneWay}" />
                        <Button Style="{StaticResource MessageActionButtonStyle}" Click="OnReplyClick" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind ReplyTip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE97A;" FontSize="11" />
                                <TextBlock FontSize="11" Text="{x:Bind ReplyLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MessageActionButtonStyle}" Click="OnCopyClick" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind CopyTip}" Visibility="{x:Bind BodyVisibility}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                <TextBlock FontSize="11" Text="{x:Bind CopyLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Operator or AI: on the right, with their photo beside the last bubble of a run. -->
        <DataTemplate x:Key="OutgoingTemplate" x:DataType="vm:MessageItem">
            <Grid Margin="0,1" HorizontalAlignment="Right" ColumnSpacing="10" Opacity="{x:Bind Opacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <StackPanel MaxWidth="540" Spacing="4" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" Margin="8,0" Visibility="{x:Bind SenderVisibility}">
                        <FontIcon Glyph="&#xE945;" FontSize="11" Foreground="{ThemeResource AiBrush}" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AiBrush}" Text="{x:Bind SenderName}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind Attachments}" ItemTemplate="{StaticResource OutgoingAttachmentTemplate}" ItemsPanel="{StaticResource AttachmentPanel}" HorizontalAlignment="Right" Visibility="{x:Bind AttachmentsVisibility}" />
                    <Border Padding="14,9,14,10" HorizontalAlignment="Right" Background="{ThemeResource BubbleOutgoingBrush}" CornerRadius="18,18,6,18" Visibility="{x:Bind BodyVisibility}">
                        <StackPanel Spacing="6">
                            <Button Style="{StaticResource QuoteButtonStyle}" Background="{ThemeResource BubbleOutgoingQuoteBrush}" BorderBrush="{ThemeResource BubbleOutgoingTextBrush}" Visibility="{x:Bind QuoteVisibility, Mode=OneWay}" Click="OnQuoteClick" Tag="{x:Bind}">
                                <StackPanel Spacing="1">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource BubbleOutgoingTextBrush}" Text="{x:Bind QuoteSender, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource BubbleOutgoingMetaBrush}" Text="{x:Bind QuoteText, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" TextReadingOrder="DetectFromContent" />
                                </StackPanel>
                            </Button>
                            <TextBlock FontSize="14" LineHeight="23" Foreground="{ThemeResource BubbleOutgoingTextBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" TextReadingOrder="DetectFromContent" TextAlignment="DetectFromContent" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0,6,4" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MessageActionButtonStyle}" Click="OnReplyClick" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind ReplyTip}" Visibility="{x:Bind ActionsVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE97A;" FontSize="11" />
                                <TextBlock FontSize="11" Text="{x:Bind ReplyLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MessageActionButtonStyle}" Click="OnCopyClick" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind CopyTip}" Visibility="{x:Bind BodyVisibility}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                <TextBlock FontSize="11" Text="{x:Bind CopyLabel}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Margin="6,0,2,0" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Meta, Mode=OneWay}" Visibility="{x:Bind MetaVisibility, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <controls:Avatar
                    Grid.Column="1"
                    Size="32"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Kind="{x:Bind AvatarKind}"
                    DisplayName="{x:Bind AvatarName, Mode=OneWay}"
                    ImageUrl="{x:Bind AvatarUrl, Mode=OneWay}"
                    Visibility="{x:Bind AvatarVisibility, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SystemTemplate" x:DataType="vm:MessageItem">
            <Border Margin="0,8" Padding="12,5" HorizontalAlignment="Center" Background="{ThemeResource ElevatedBrush}" CornerRadius="8">
                <TextBlock FontSize="12" Foreground="{ThemeResource Text2Brush}" Text="{x:Bind Body}" TextAlignment="Center" TextReadingOrder="DetectFromContent" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DayTemplate" x:DataType="vm:MessageItem">
            <Grid Margin="0,14,0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" Fill="{ThemeResource LineBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Body}" />
                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource LineBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <h:MessageTemplateSelector
            x:Key="MessageSelector"
            Incoming="{StaticResource IncomingTemplate}"
            Outgoing="{StaticResource OutgoingTemplate}"
            System="{StaticResource SystemTemplate}"
            Day="{StaticResource DayTemplate}" />
    </UserControl.Resources>

    <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailsColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <!-- Nothing chosen yet. -->
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="72" Height="72" CornerRadius="19" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                        <FontIcon FontSize="30" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE8F2;" />
                    </Border>
                    <TextBlock x:Name="PlaceholderTitle" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="PlaceholderBody" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                    <controls:CampaignCard Width="420" Margin="0,18,0,0" Placement="chat_empty" />
                </StackPanel>

                <Grid x:Name="ThreadPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Padding="16,10,10,10" ColumnSpacing="12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:Avatar x:Name="HeaderAvatar" Size="40" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="NameText" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <Border x:Name="StatusChip" Style="{StaticResource ChipBorder}" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusText" Style="{StaticResource ChipText}" />
                                </Border>
                                <Border x:Name="PriorityChip" Style="{StaticResource ChipBorder}" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="PriorityText" Style="{StaticResource ChipText}" />
                                </Border>
                                <!-- The AI is answering: as the sparkles beside the name on iOS. -->
                                <Border x:Name="AiChip" Style="{StaticResource ChipBorder}" VerticalAlignment="Center" Background="{ThemeResource AiSoftBrush}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE945;" FontSize="10" Foreground="{ThemeResource AiBrush}" />
                                        <TextBlock x:Name="AiChipText" Style="{StaticResource ChipText}" Foreground="{ThemeResource AiBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SubText" FontSize="12" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="AudioCallButton" Style="{StaticResource IconButton}" Click="OnAudioCall">
                                <FontIcon Glyph="&#xE717;" FontSize="15" />
                            </Button>
                            <Button x:Name="VideoCallButton" Style="{StaticResource IconButton}" Click="OnVideoCall">
                                <FontIcon Glyph="&#xE714;" FontSize="15" />
                            </Button>
                            <Button x:Name="AssignButton" Style="{StaticResource PillButton}" Click="OnAssignToMe" />
                            <Button x:Name="StatusButton" Style="{StaticResource PillAccentButton}" Click="OnToggleStatus" />
                            <Button x:Name="MoreButton" Style="{StaticResource IconButton}">
                                <FontIcon Glyph="&#xE712;" FontSize="15" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="MoreMenu" Opening="OnMoreOpening" />
                                </Button.Flyout>
                            </Button>
                            <ToggleButton x:Name="DetailsToggle" Padding="8" MinWidth="34" MinHeight="34" CornerRadius="8" BorderThickness="0" Background="Transparent" IsChecked="True" Click="OnToggleDetails">
                                <!-- Checked is a soft tint with the brand colour, not a filled blue block. -->
                                <ToggleButton.Resources>
                                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="BrandSoftBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="BrandSoftBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="BrandSoftBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="BrandBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="BrandBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="BrandBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="BrandSoftBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="BrandSoftBrush" />
                                </ToggleButton.Resources>
                                <FontIcon Glyph="&#xE8A0;" FontSize="15" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <!-- A call with this visitor slides down here, under the header, as on the Mac. -->
                        <controls:CallDockSlot x:Name="DockSlot" />
                        <InfoBar x:Name="Error" Margin="12,8,12,0" Severity="Error" IsClosable="True" />
                    </StackPanel>

                    <Grid Grid.Row="2" Background="{ThemeResource ChatBackgroundBrush}">
                        <ListView
                            x:Name="Messages"
                            FlowDirection="LeftToRight"
                            Padding="18,10,18,12"
                            IsItemClickEnabled="False"
                            ItemTemplateSelector="{StaticResource MessageSelector}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                        <ProgressRing x:Name="Loading" Width="28" Height="28" IsActive="False" />
                    </Grid>

                    <!--
                        Composer: one rounded card that lights up in the brand colour
                        while typing — text on top, tools and the send button below,
                        as in Teams and the web console.
                    -->
                    <StackPanel Grid.Row="3" Padding="16,4,16,16" Spacing="8" Background="{ThemeResource ChatBackgroundBrush}">
                        <!-- Replying to a message: the quote rides above the composer until Send or ✕. -->
                        <Border x:Name="ReplyBar" Visibility="Collapsed" Padding="12,8,8,8" CornerRadius="12" Background="{ThemeResource ComposerBrush}" BorderBrush="{ThemeResource ComposerBorderBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE97A;" FontSize="14" Foreground="{ThemeResource BrandBrush}" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="1" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource BrandBrush}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="ReplyBarTitle" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ReplyBarText" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent" />
                                </StackPanel>
                                <Button x:Name="ReplyBarClose" Grid.Column="3" Style="{StaticResource IconButton}" MinWidth="28" MinHeight="28" Padding="4" CornerRadius="8" VerticalAlignment="Center" Click="OnCancelReply">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border x:Name="ComposerCard" CornerRadius="14" BorderBrush="{ThemeResource ComposerBorderBrush}" BorderThickness="1" Background="{ThemeResource ComposerBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- The file about to go out sits inside the card, with the text, until Send. -->
                                <Border x:Name="PendingFile" Visibility="Collapsed" HorizontalAlignment="Left" Margin="10,10,10,0" Padding="6,6,6,6" CornerRadius="12" Background="{ThemeResource ComposerBarBrush}" BorderBrush="{ThemeResource ComposerBorderBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource BrandSoftBrush}">
                                            <Grid>
                                                <FontIcon x:Name="PendingGlyph" Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource BrandBrush}" />
                                                <Image x:Name="PendingThumb" Stretch="UniformToFill" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MaxWidth="300">
                                            <TextBlock x:Name="PendingFileName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="PendingFileSize" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" MinWidth="28" MinHeight="28" Padding="4" CornerRadius="8" VerticalAlignment="Center" Click="OnClearPendingFile">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <!-- While recording a voice note: it takes the text's place. -->
                                <Grid x:Name="RecordBar" Grid.Row="1" Visibility="Collapsed" MinHeight="46" Padding="16,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="{ThemeResource DangerBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecordTime" Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="0:00" />
                                    <TextBlock x:Name="RecordHint" Grid.Column="2" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBox
                                    x:Name="Composer"
                                    Grid.Row="1"
                                    MinHeight="46"
                                    MaxHeight="180"
                                    Padding="16,13,16,6"
                                    FontSize="14"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    GotFocus="OnComposerFocus"
                                    LostFocus="OnComposerFocus"
                                    TextChanged="OnComposerChanged"
                                    PreviewKeyDown="OnComposerKeyDown">
                                    <TextBox.Resources>
                                        <!-- No box inside the box: the card itself shows focus. -->
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>
                                <Grid Grid.Row="2" Padding="8,2,8,8" ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--
                                        On a thread the AI is answering, the operator does not write to
                                        the visitor directly: the AI says it, in the specialist's voice or
                                        its own — the iOS say-now. This picks the voice.
                                    -->
                                    <DropDownButton x:Name="VoicePicker" Visibility="Collapsed" Padding="10,5" CornerRadius="8" BorderThickness="0" Background="{ThemeResource AiSoftBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon x:Name="VoiceGlyph" Glyph="&#xE77B;" FontSize="14" Foreground="{ThemeResource AiBrush}" />
                                            <TextBlock x:Name="VoiceText" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource AiBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout x:Name="VoiceMenu" Placement="TopEdgeAlignedLeft">
                                                <RadioMenuFlyoutItem x:Name="VoiceSpecialist" GroupName="voice" IsChecked="True" Tag="specialist" Click="OnVoicePicked">
                                                    <RadioMenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE77B;" />
                                                    </RadioMenuFlyoutItem.Icon>
                                                </RadioMenuFlyoutItem>
                                                <RadioMenuFlyoutItem x:Name="VoiceAssistant" GroupName="voice" Tag="assistant" Click="OnVoicePicked">
                                                    <RadioMenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE945;" />
                                                    </RadioMenuFlyoutItem.Icon>
                                                </RadioMenuFlyoutItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button x:Name="AttachButton" Style="{StaticResource IconButton}" Click="OnAttach">
                                        <FontIcon Glyph="&#xE723;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="EmojiButton" Grid.Column="1" Style="{StaticResource IconButton}">
                                        <FontIcon Glyph="&#xE76E;" FontSize="16" />
                                        <Button.Flyout>
                                            <Flyout x:Name="EmojiFlyout" Placement="TopEdgeAlignedLeft">
                                                <GridView x:Name="EmojiGrid" Width="316" MaxHeight="248" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEmojiPicked">
                                                    <GridView.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Width="30" Height="30" FontSize="20" Text="{x:Bind}" TextAlignment="Center" FontFamily="Segoe UI Emoji" />
                                                        </DataTemplate>
                                                    </GridView.ItemTemplate>
                                                </GridView>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Name="ShortcutsButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="OnShortcuts">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout x:Name="ShortcutsFlyout" Placement="TopEdgeAlignedLeft">
                                                <StackPanel Width="340" Spacing="8">
                                                    <AutoSuggestBox x:Name="ShortcutSearch" QueryIcon="Find" TextChanged="OnShortcutSearch" />
                                                    <ListView x:Name="ShortcutList" MaxHeight="300" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnShortcutPicked">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ShortcutItem">
                                                                <StackPanel Padding="0,6" Spacing="2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                                        <TextBlock Foreground="{ThemeResource BrandBrush}" FontSize="12" Text="{x:Bind Shortcut}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock FontSize="12" Foreground="{ThemeResource Text2Brush}" Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                    <TextBlock x:Name="ShortcutEmpty" Style="{StaticResource MutedText}" Visibility="Collapsed" />
                                                </StackPanel>
                                            </Flyout>
                                        </FlyoutBase.AttachedFlyout>
                                    </Button>
                                    <TextBlock x:Name="ComposerHint" Grid.Column="3" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" TextTrimming="CharacterEllipsis" />
                                    <!-- Voice note: record, stop (it lands in the card like any file) or throw away. -->
                                    <Button x:Name="RecordCancelButton" Grid.Column="4" Style="{StaticResource IconButton}" Visibility="Collapsed" Click="OnRecordCancel">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource DangerBrush}" />
                                    </Button>
                                    <Button x:Name="MicButton" Grid.Column="5" Width="36" Height="36" Padding="0" CornerRadius="10" Margin="0,0,6,0" Style="{StaticResource IconButton}" Click="OnMic">
                                        <FontIcon x:Name="MicGlyph" Glyph="&#xE720;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="SendButton" Grid.Column="6" Width="36" Height="36" Padding="0" CornerRadius="10" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnSend">
                                        <!-- The paper plane points the way text runs. -->
                                        <FontIcon x:Name="SendGlyph" FontSize="14" Glyph="&#xE724;" MirroredWhenRightToLeft="True" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <views:DetailsPanel x:Name="Details" Grid.Column="1" Width="300" Visibility="Collapsed" />
    </Grid>
</UserControl>
