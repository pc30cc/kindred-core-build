<UserControl
    x:Class="Webyar.App.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Webyar.App.ViewModels"
    xmlns:h="using:Webyar.App.Helpers">
    <UserControl.Resources>
        <DataTemplate x:Key="IncomingTemplate" x:DataType="vm:MessageItem">
            <StackPanel Margin="0,3" HorizontalAlignment="Left" MaxWidth="560" Spacing="3">
                <Border Padding="12,8" Background="{ThemeResource BubbleIncomingBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14,14,14,4">
                    <StackPanel Spacing="4">
                        <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" Visibility="{x:Bind BodyVisibility}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Attachments}" TextWrapping="Wrap" Visibility="{x:Bind AttachmentsVisibility}" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="6,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="OutgoingTemplate" x:DataType="vm:MessageItem">
            <StackPanel Margin="0,3" HorizontalAlignment="Right" MaxWidth="560" Spacing="3" Opacity="{x:Bind Opacity, Mode=OneWay}">
                <Border Padding="12,8" Background="{ThemeResource BubbleOutgoingBrush}" CornerRadius="14,14,4,14">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource BubbleOutgoingTextBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" Visibility="{x:Bind BodyVisibility}" />
                        <TextBlock Foreground="{ThemeResource BubbleOutgoingTextBrush}" Opacity="0.85" Text="{x:Bind Attachments}" TextWrapping="Wrap" Visibility="{x:Bind AttachmentsVisibility}" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="6,0" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SystemTemplate" x:DataType="vm:MessageItem">
            <Border Margin="0,8" Padding="12,4" HorizontalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Body}" TextAlignment="Center" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <h:MessageTemplateSelector
            x:Key="MessageSelector"
            Incoming="{StaticResource IncomingTemplate}"
            Outgoing="{StaticResource OutgoingTemplate}"
            System="{StaticResource SystemTemplate}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource ChatBackgroundBrush}">
        <!-- Nothing chosen yet. -->
        <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8F2;" />
            <TextBlock x:Name="PlaceholderTitle" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="PlaceholderBody" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid x:Name="ThreadPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="20,12" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource AvatarBrush}">
                    <TextBlock x:Name="AvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AvatarTextBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AssignButton" Click="OnAssignToMe" />
                    <Button x:Name="StatusButton" Style="{StaticResource AccentButtonStyle}" Click="OnToggleStatus" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="Error" Grid.Row="1" Margin="12,8,12,0" Severity="Error" IsClosable="True" />

            <ListView
                x:Name="Messages"
                Grid.Row="2"
                Padding="20,12"
                IsItemClickEnabled="False"
                ItemTemplateSelector="{StaticResource MessageSelector}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
            <ProgressRing x:Name="Loading" Grid.Row="2" Width="28" Height="28" IsActive="False" />

            <Grid Grid.Row="3" Padding="16,10,16,14" ColumnSpacing="10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="Composer"
                    MaxHeight="160"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextChanged="OnComposerChanged"
                    PreviewKeyDown="OnComposerKeyDown" />
                <Button x:Name="SendButton" Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnSend">
                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
