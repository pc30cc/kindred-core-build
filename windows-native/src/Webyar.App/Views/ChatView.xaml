<UserControl
    x:Class="Webyar.App.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Webyar.App.ViewModels"
    xmlns:h="using:Webyar.App.Helpers"
    xmlns:controls="using:Webyar.App.Controls"
    xmlns:views="using:Webyar.App.Views">
    <UserControl.Resources>
        <!-- Files on a message: a photo preview, or a chip with the name and size. -->
        <DataTemplate x:Key="AttachmentTemplate" x:DataType="vm:AttachmentItem">
            <Grid Margin="0,2">
                <Button Padding="0" BorderThickness="0" Background="Transparent" CornerRadius="10" Visibility="{x:Bind ImageVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <Grid MinWidth="160" MinHeight="100" MaxWidth="280" MaxHeight="260" CornerRadius="10" Background="{ThemeResource ElevatedBrush}">
                        <FontIcon Glyph="&#xEB9F;" FontSize="22" Foreground="{ThemeResource Text3Brush}" />
                        <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="Uniform" />
                    </Grid>
                </Button>
                <!-- Voice notes play right here. -->
                <Border Visibility="{x:Bind AudioVisibility}" CornerRadius="999" Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                    <controls:AudioPlayer Source="{x:Bind}" />
                </Border>
                <Button Padding="10,8" CornerRadius="10" Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource LineBrush}" Visibility="{x:Bind FileVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource BrandSoftBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource BrandBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="200">
                            <TextBlock Text="{x:Bind FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SizeText}" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Visitor: on the left, with their avatar under the last bubble of a run (the web thread). -->
        <DataTemplate x:Key="IncomingTemplate" x:DataType="vm:MessageItem">
            <Grid Margin="0,2" HorizontalAlignment="Left" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Avatar
                    Size="34"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    DisplayName="{x:Bind AvatarName, Mode=OneWay}"
                    Email="{x:Bind AvatarEmail, Mode=OneWay}"
                    Os="{x:Bind AvatarOs, Mode=OneWay}"
                    ImageUrl="{x:Bind AvatarUrl, Mode=OneWay}"
                    Visibility="{x:Bind AvatarVisibility, Mode=OneWay}" />
                <StackPanel Grid.Column="1" MaxWidth="560" Spacing="3">
                    <Border Padding="14,10" Background="{ThemeResource BubbleIncomingBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="18,18,18,5">
                        <StackPanel Spacing="6">
                            <ItemsControl ItemsSource="{x:Bind Attachments}" ItemTemplate="{StaticResource AttachmentTemplate}" Visibility="{x:Bind AttachmentsVisibility}" />
                            <TextBlock FontSize="14" LineHeight="24" IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" TextReadingOrder="DetectFromContent" TextAlignment="DetectFromContent" Foreground="{ThemeResource TextBrush}" Visibility="{x:Bind BodyVisibility}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="6,0" FontSize="11" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Meta, Mode=OneWay}" Visibility="{x:Bind MetaVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Operator or AI: on the right, with their photo under the last bubble of a run. -->
        <DataTemplate x:Key="OutgoingTemplate" x:DataType="vm:MessageItem">
            <Grid Margin="0,2" HorizontalAlignment="Right" ColumnSpacing="10" Opacity="{x:Bind Opacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <StackPanel MaxWidth="560" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" Visibility="{x:Bind SenderVisibility}">
                        <FontIcon Glyph="&#xE945;" FontSize="11" Foreground="{ThemeResource AiBrush}" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AiBrush}" Text="{x:Bind SenderName}" />
                    </StackPanel>
                    <Border Padding="14,10" Background="{ThemeResource BubbleOutgoingBrush}" CornerRadius="18,18,5,18" HorizontalAlignment="Right">
                        <StackPanel Spacing="6">
                            <ItemsControl ItemsSource="{x:Bind Attachments}" ItemTemplate="{StaticResource AttachmentTemplate}" Visibility="{x:Bind AttachmentsVisibility}" />
                            <TextBlock FontSize="14" LineHeight="24" Foreground="{ThemeResource BubbleOutgoingTextBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" TextReadingOrder="DetectFromContent" TextAlignment="DetectFromContent" Visibility="{x:Bind BodyVisibility}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="6,0" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Meta, Mode=OneWay}" Visibility="{x:Bind MetaVisibility, Mode=OneWay}" />
                </StackPanel>
                <controls:Avatar
                    Grid.Column="1"
                    Size="34"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Kind="{x:Bind AvatarKind}"
                    DisplayName="{x:Bind AvatarName, Mode=OneWay}"
                    ImageUrl="{x:Bind AvatarUrl, Mode=OneWay}"
                    Visibility="{x:Bind AvatarVisibility, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SystemTemplate" x:DataType="vm:MessageItem">
            <Border Margin="0,8" Padding="12,5" HorizontalAlignment="Center" Background="{ThemeResource ElevatedBrush}" CornerRadius="999">
                <TextBlock FontSize="12" Foreground="{ThemeResource Text2Brush}" Text="{x:Bind Body}" TextAlignment="Center" TextReadingOrder="DetectFromContent" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DayTemplate" x:DataType="vm:MessageItem">
            <Grid Margin="0,14,0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" Fill="{ThemeResource LineBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Body}" />
                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource LineBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <h:MessageTemplateSelector
            x:Key="MessageSelector"
            Incoming="{StaticResource IncomingTemplate}"
            Outgoing="{StaticResource OutgoingTemplate}"
            System="{StaticResource SystemTemplate}"
            Day="{StaticResource DayTemplate}" />
    </UserControl.Resources>

    <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailsColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <!-- Nothing chosen yet. -->
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                        <FontIcon FontSize="30" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE8F2;" />
                    </Border>
                    <TextBlock x:Name="PlaceholderTitle" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="PlaceholderBody" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                </StackPanel>

                <Grid x:Name="ThreadPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Padding="16,10,10,10" ColumnSpacing="12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:Avatar x:Name="HeaderAvatar" Size="40" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="NameText" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <Border x:Name="StatusChip" Style="{StaticResource ChipBorder}" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusText" Style="{StaticResource ChipText}" />
                                </Border>
                                <Border x:Name="PriorityChip" Style="{StaticResource ChipBorder}" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="PriorityText" Style="{StaticResource ChipText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SubText" FontSize="12" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="AudioCallButton" Style="{StaticResource IconButton}" Click="OnAudioCall">
                                <FontIcon Glyph="&#xE717;" FontSize="15" />
                            </Button>
                            <Button x:Name="VideoCallButton" Style="{StaticResource IconButton}" Click="OnVideoCall">
                                <FontIcon Glyph="&#xE714;" FontSize="15" />
                            </Button>
                            <Button x:Name="AssignButton" Style="{StaticResource PillButton}" Click="OnAssignToMe" />
                            <Button x:Name="StatusButton" Style="{StaticResource PillAccentButton}" Click="OnToggleStatus" />
                            <Button x:Name="MoreButton" Style="{StaticResource IconButton}">
                                <FontIcon Glyph="&#xE712;" FontSize="15" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="MoreMenu" Opening="OnMoreOpening" />
                                </Button.Flyout>
                            </Button>
                            <ToggleButton x:Name="DetailsToggle" Padding="8" MinWidth="34" MinHeight="34" CornerRadius="8" BorderThickness="0" Background="Transparent" IsChecked="True" Click="OnToggleDetails">
                                <FontIcon Glyph="&#xE8A0;" FontSize="15" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="Error" Grid.Row="1" Margin="12,8,12,0" Severity="Error" IsClosable="True" />

                    <Grid Grid.Row="2" Background="{ThemeResource ChatBackgroundBrush}">
                        <ListView
                            x:Name="Messages"
                            FlowDirection="LeftToRight"
                            Padding="18,10,18,12"
                            IsItemClickEnabled="False"
                            ItemTemplateSelector="{StaticResource MessageSelector}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                        <ProgressRing x:Name="Loading" Width="28" Height="28" IsActive="False" />
                    </Grid>

                    <!-- Composer -->
                    <StackPanel Grid.Row="3" Padding="14,10,14,14" Spacing="8" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                        <Border x:Name="PendingFile" Visibility="Collapsed" HorizontalAlignment="Left" Padding="10,6" CornerRadius="10" Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource BrandBrush}" />
                                <TextBlock x:Name="PendingFileName" VerticalAlignment="Center" FontSize="12.5" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                                <Button Style="{StaticResource IconButton}" MinWidth="24" MinHeight="24" Padding="4" Click="OnClearPendingFile">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="12" BorderBrush="{ThemeResource LineStrongBrush}" BorderThickness="1" Background="{ThemeResource SurfaceBrush}" Padding="6,4">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AttachButton" Style="{StaticResource IconButton}" VerticalAlignment="Bottom" Click="OnAttach">
                                    <FontIcon Glyph="&#xE723;" FontSize="15" />
                                </Button>
                                <Button x:Name="ShortcutsButton" Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Bottom" Click="OnShortcuts">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="15" />
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout x:Name="ShortcutsFlyout" Placement="TopEdgeAlignedLeft">
                                            <StackPanel Width="340" Spacing="8">
                                                <AutoSuggestBox x:Name="ShortcutSearch" QueryIcon="Find" TextChanged="OnShortcutSearch" />
                                                <ListView x:Name="ShortcutList" MaxHeight="300" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnShortcutPicked">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ShortcutItem">
                                                            <StackPanel Padding="0,6" Spacing="2">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                                    <TextBlock Foreground="{ThemeResource BrandBrush}" FontSize="12" Text="{x:Bind Shortcut}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock FontSize="12" Foreground="{ThemeResource Text2Brush}" Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <TextBlock x:Name="ShortcutEmpty" Style="{StaticResource MutedText}" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </Button>
                                <TextBox
                                    x:Name="Composer"
                                    Grid.Column="2"
                                    MaxHeight="160"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    TextChanged="OnComposerChanged"
                                    PreviewKeyDown="OnComposerKeyDown" />
                                <Button x:Name="SendButton" Grid.Column="3" VerticalAlignment="Bottom" Width="38" Height="34" Padding="0" CornerRadius="9" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnSend">
                                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <views:DetailsPanel x:Name="Details" Grid.Column="1" Width="300" Visibility="Collapsed" />
    </Grid>
</UserControl>
