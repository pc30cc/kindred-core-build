<Page
    x:Class="Webyar.App.Views.ColleaguesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Webyar.App.ViewModels"
    xmlns:h="using:Webyar.App.Helpers"
    xmlns:controls="using:Webyar.App.Controls"
    Background="Transparent">
    <Page.Resources>
        <DataTemplate x:Key="TeamIn" x:DataType="vm:TeamMessageItem">
            <StackPanel Margin="0,2" HorizontalAlignment="Left" MaxWidth="520" Spacing="3">
                <Border Padding="13,9" Background="{ThemeResource BubbleIncomingBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="16,16,16,5">
                    <TextBlock FontSize="14" IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" Visibility="{x:Bind BodyVisibility}" />
                </Border>
                <TextBlock Margin="6,0" FontSize="11" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Meta}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TeamOut" x:DataType="vm:TeamMessageItem">
            <StackPanel Margin="0,2" HorizontalAlignment="Right" MaxWidth="520" Spacing="3">
                <Border Padding="13,9" Background="{ThemeResource BubbleOutgoingBrush}" CornerRadius="16,16,5,16">
                    <TextBlock FontSize="14" Foreground="{ThemeResource BubbleOutgoingTextBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" Visibility="{x:Bind BodyVisibility}" />
                </Border>
                <TextBlock Margin="6,0" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Meta}" />
            </StackPanel>
        </DataTemplate>
        <h:TeamMessageTemplateSelector x:Key="TeamSelector" Incoming="{StaticResource TeamIn}" Outgoing="{StaticResource TeamOut}" />
    </Page.Resources>

    <Grid Padding="10" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HeaderText" Margin="16,14,16,4" Style="{StaticResource PaneTitle}" />
                <AutoSuggestBox x:Name="Search" Grid.Row="1" Margin="12,6,12,8" QueryIcon="Find" TextChanged="OnSearch" />
                <Grid Grid.Row="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                    <ListView x:Name="List" Padding="6" SelectionMode="Single" SelectionChanged="OnSelect">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColleagueItem">
                                <Grid Padding="2,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Avatar Size="40" DisplayName="{x:Bind Name, Mode=OneWay}" ImageUrl="{x:Bind AvatarUrl, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12.5" Foreground="{ThemeResource Text2Brush}" Text="{x:Bind Preview, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Stamp, Mode=OneWay}" />
                                        <Border MinWidth="20" Height="20" Padding="6,0" HorizontalAlignment="Right" Background="{ThemeResource BrandBrush}" CornerRadius="10" Visibility="{x:Bind UnreadVisibility, Mode=OneWay}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" Text="{x:Bind UnreadText, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="Empty" Margin="24" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock x:Name="EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ProgressRing x:Name="Loading" IsActive="True" Width="28" Height="28" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
            <Grid>
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                        <FontIcon FontSize="30" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE716;" />
                    </Border>
                    <TextBlock x:Name="PlaceholderTitle" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="PlaceholderBody" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                </StackPanel>
                <Grid x:Name="Thread" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="16,12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                        <controls:Avatar x:Name="PeerAvatar" Size="38" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PeerName" FontSize="15" FontWeight="Bold" />
                            <TextBlock x:Name="PeerRole" FontSize="12" Foreground="{ThemeResource Text2Brush}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Background="{ThemeResource ChatBackgroundBrush}">
                        <ListView x:Name="Messages" Padding="18,10" SelectionMode="None" ItemTemplateSelector="{StaticResource TeamSelector}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                        <TextBlock x:Name="ThreadEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}" Visibility="Collapsed" />
                    </Grid>
                    <Border Grid.Row="2" Margin="14,10,14,14" CornerRadius="12" BorderBrush="{ThemeResource LineStrongBrush}" BorderThickness="1" Background="{ThemeResource SurfaceBrush}" Padding="6,4">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" BorderThickness="0" Background="Transparent" TextChanged="OnComposerChanged" PreviewKeyDown="OnComposerKeyDown" />
                            <Button x:Name="SendButton" Grid.Column="1" VerticalAlignment="Bottom" Width="38" Height="34" Padding="0" CornerRadius="9" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnSend">
                                <FontIcon FontSize="14" Glyph="&#xE724;" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
