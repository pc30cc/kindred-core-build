<Page
    x:Class="Webyar.App.Views.ColleaguesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Webyar.App.ViewModels"
    xmlns:h="using:Webyar.App.Helpers"
    xmlns:controls="using:Webyar.App.Controls"
    Background="Transparent">
    <!--
        The internal inbox: the team on the start side with their presence and
        last message, and the chat with one colleague — the same bubbles,
        photos, voice notes and files as the visitor thread, and a composer
        with files, emoji and voice recording.
    -->
    <Page.Resources>
        <DataTemplate x:Key="TeamInFile" x:DataType="vm:AttachmentItem">
            <Grid HorizontalAlignment="Left">
                <Button Style="{StaticResource BubbleButtonStyle}" CornerRadius="16" Visibility="{x:Bind ImageVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <Border CornerRadius="16" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" BorderThickness="1" Background="{ThemeResource ElevatedBrush}">
                        <Grid Width="{x:Bind PreviewWidth, Mode=OneWay}" Height="{x:Bind PreviewHeight, Mode=OneWay}">
                            <FontIcon Glyph="&#xEB9F;" FontSize="24" Foreground="{ThemeResource Text3Brush}" />
                            <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                </Button>
                <Border Visibility="{x:Bind AudioVisibility}" CornerRadius="27" Background="{ThemeResource BubbleIncomingBrush}" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" BorderThickness="1">
                    <controls:AudioPlayer Source="{x:Bind}" />
                </Border>
                <Button Style="{StaticResource BubbleButtonStyle}" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" Background="{ThemeResource BubbleIncomingBrush}" Visibility="{x:Bind FileVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <Grid Width="260" Padding="10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="{ThemeResource BrandSoftBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource BrandBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SizeText}" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TeamOutFile" x:DataType="vm:AttachmentItem">
            <Grid HorizontalAlignment="Right">
                <Button Style="{StaticResource BubbleButtonStyle}" CornerRadius="16" Visibility="{x:Bind ImageVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <Border CornerRadius="16" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" BorderThickness="1" Background="{ThemeResource ElevatedBrush}">
                        <Grid Width="{x:Bind PreviewWidth, Mode=OneWay}" Height="{x:Bind PreviewHeight, Mode=OneWay}">
                            <FontIcon Glyph="&#xEB9F;" FontSize="24" Foreground="{ThemeResource Text3Brush}" />
                            <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                </Button>
                <Border Visibility="{x:Bind AudioVisibility}" CornerRadius="27" Background="{ThemeResource BubbleOutgoingBrush}">
                    <controls:AudioPlayer Source="{x:Bind}" Outgoing="True" />
                </Border>
                <Button Style="{StaticResource BubbleButtonStyle}" CornerRadius="14" Background="{ThemeResource BubbleOutgoingBrush}" Visibility="{x:Bind FileVisibility}" Click="OnOpenAttachment" Tag="{x:Bind}">
                    <Grid Width="260" Padding="10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="#33FFFFFF">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind FileName}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SizeText}" FontSize="11.5" Foreground="{ThemeResource BubbleOutgoingMetaBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE896;" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="FilePanel">
            <StackPanel Spacing="4" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="TeamIn" x:DataType="vm:TeamMessageItem">
            <Grid Margin="0,1" HorizontalAlignment="Left" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Avatar Size="32" Kind="operator" VerticalAlignment="Bottom" Margin="0,0,0,20"
                                 DisplayName="{x:Bind AvatarName, Mode=OneWay}" ImageUrl="{x:Bind AvatarUrl, Mode=OneWay}"
                                 Visibility="{x:Bind AvatarVisibility, Mode=OneWay}" />
                <StackPanel Grid.Column="1" MaxWidth="520" Spacing="4" HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{x:Bind Attachments}" ItemTemplate="{StaticResource TeamInFile}" ItemsPanel="{StaticResource FilePanel}" Visibility="{x:Bind AttachmentsVisibility}" />
                    <Border Padding="14,9,14,10" HorizontalAlignment="Left" Background="{ThemeResource BubbleIncomingBrush}" BorderBrush="{ThemeResource BubbleIncomingBorderBrush}" BorderThickness="1" CornerRadius="18,18,18,6" Visibility="{x:Bind BodyVisibility}">
                        <TextBlock FontSize="14" LineHeight="23" IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" TextReadingOrder="DetectFromContent" TextAlignment="DetectFromContent" Foreground="{ThemeResource TextBrush}" />
                    </Border>
                    <TextBlock Margin="8,0,8,4" FontSize="11" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Meta, Mode=OneWay}" Visibility="{x:Bind MetaVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TeamOut" x:DataType="vm:TeamMessageItem">
            <Grid Margin="0,1" HorizontalAlignment="Right" Opacity="{x:Bind Opacity, Mode=OneWay}">
                <StackPanel MaxWidth="520" Spacing="4" HorizontalAlignment="Right">
                    <ItemsControl ItemsSource="{x:Bind Attachments}" ItemTemplate="{StaticResource TeamOutFile}" ItemsPanel="{StaticResource FilePanel}" HorizontalAlignment="Right" Visibility="{x:Bind AttachmentsVisibility}" />
                    <Border Padding="14,9,14,10" HorizontalAlignment="Right" Background="{ThemeResource BubbleOutgoingBrush}" CornerRadius="18,18,6,18" Visibility="{x:Bind BodyVisibility}">
                        <TextBlock FontSize="14" LineHeight="23" Foreground="{ThemeResource BubbleOutgoingTextBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Body}" TextWrapping="Wrap" TextReadingOrder="DetectFromContent" TextAlignment="DetectFromContent" />
                    </Border>
                    <TextBlock Margin="8,0,8,4" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Meta, Mode=OneWay}" Visibility="{x:Bind MetaVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TeamDay" x:DataType="vm:TeamMessageItem">
            <Grid Margin="0,14,0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" Fill="{ThemeResource LineBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Padding="10,3" CornerRadius="999" Background="{ThemeResource ElevatedBrush}">
                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Body}" />
                </Border>
                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource LineBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <h:TeamMessageTemplateSelector x:Key="TeamSelector" Incoming="{StaticResource TeamIn}" Outgoing="{StaticResource TeamOut}" Day="{StaticResource TeamDay}" />
    </Page.Resources>

    <Grid Padding="10" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The team -->
        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,14,12,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="{ThemeResource BrandSoftBrush}">
                        <FontIcon Glyph="&#xE716;" FontSize="15" Foreground="{ThemeResource BrandBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderText" Style="{StaticResource PaneTitle}" />
                        <TextBlock x:Name="HeaderSub" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" />
                    </StackPanel>
                </Grid>
                <AutoSuggestBox x:Name="Search" Grid.Row="1" Margin="12,8,12,8" QueryIcon="Find" TextChanged="OnSearch" />
                <Grid Grid.Row="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                    <ListView x:Name="List" Padding="6" SelectionMode="Single" SelectionChanged="OnSelect">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColleagueItem">
                                <Grid Padding="2,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Avatar Size="42" Kind="operator" DisplayName="{x:Bind Name, Mode=OneWay}" ImageUrl="{x:Bind AvatarUrl, Mode=OneWay}" PresenceState="{x:Bind Presence, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12.5" Foreground="{ThemeResource Text2Brush}" Text="{x:Bind Preview, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Stamp, Mode=OneWay}" />
                                        <Border MinWidth="20" Height="20" Padding="6,0" HorizontalAlignment="Right" Background="{ThemeResource BrandBrush}" CornerRadius="10" Visibility="{x:Bind UnreadVisibility, Mode=OneWay}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" Text="{x:Bind UnreadText, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="Empty" Margin="24" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock x:Name="EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ProgressRing x:Name="Loading" IsActive="True" Width="28" Height="28" />
                </Grid>
                <!-- Super Admin's ad for this place (Desktop app -> Ads & announcements). -->
                <controls:CampaignCard Grid.Row="3" Margin="8,4,8,8" Placement="colleagues_list" />
            </Grid>
        </Border>

        <!-- The conversation -->
        <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
            <Grid>
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="80" Height="80" CornerRadius="40" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                        <FontIcon FontSize="32" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE716;" />
                    </Border>
                    <TextBlock x:Name="PlaceholderTitle" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="PlaceholderBody" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                </StackPanel>

                <Grid x:Name="Thread" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Padding="16,10,12,10" ColumnSpacing="12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:Avatar x:Name="PeerAvatar" Size="42" Kind="operator" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="PeerName" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <Border x:Name="RoleChip" Style="{StaticResource ChipBorder}" VerticalAlignment="Center">
                                    <TextBlock x:Name="PeerRole" Style="{StaticResource ChipText}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:Name="PeerDot" Width="8" Height="8" VerticalAlignment="Center" />
                                <TextBlock x:Name="PeerStatus" FontSize="12" Foreground="{ThemeResource Text2Brush}" />
                                <TextBlock x:Name="PeerEmail" FontSize="12" Foreground="{ThemeResource Text3Brush}" FlowDirection="LeftToRight" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="MailButton" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Center" Click="OnMail">
                            <FontIcon Glyph="&#xE715;" FontSize="15" />
                        </Button>
                    </Grid>

                    <InfoBar x:Name="Error" Grid.Row="1" Margin="12,8,12,0" Severity="Error" IsClosable="True" />

                    <Grid Grid.Row="2" Background="{ThemeResource ChatBackgroundBrush}">
                        <ListView x:Name="Messages" FlowDirection="LeftToRight" Padding="18,10,18,12" SelectionMode="None" IsItemClickEnabled="False" ItemTemplateSelector="{StaticResource TeamSelector}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                        <StackPanel x:Name="ThreadEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                            <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource ElevatedBrush}" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8BD;" FontSize="24" Foreground="{ThemeResource Text3Brush}" />
                            </Border>
                            <TextBlock x:Name="ThreadEmptyText" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Composer: the same card as the visitor thread. -->
                    <StackPanel Grid.Row="3" Padding="16,4,16,16" Background="{ThemeResource ChatBackgroundBrush}">
                        <Border x:Name="ComposerCard" CornerRadius="14" BorderBrush="{ThemeResource ComposerBorderBrush}" BorderThickness="1" Background="{ThemeResource ComposerBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="PendingFile" Visibility="Collapsed" HorizontalAlignment="Left" Margin="10,10,10,0" Padding="6" CornerRadius="12" Background="{ThemeResource ComposerBarBrush}" BorderBrush="{ThemeResource ComposerBorderBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource BrandSoftBrush}">
                                            <Grid>
                                                <FontIcon x:Name="PendingGlyph" Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource BrandBrush}" />
                                                <Ellipse x:Name="PendingThumbCircle" Visibility="Collapsed">
                                                    <Ellipse.Fill>
                                                        <ImageBrush x:Name="PendingThumb" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MaxWidth="300">
                                            <TextBlock x:Name="PendingFileName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="PendingFileSize" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" MinWidth="28" MinHeight="28" Padding="4" VerticalAlignment="Center" Click="OnClearPendingFile">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <Grid x:Name="RecordBar" Grid.Row="1" Visibility="Collapsed" MinHeight="46" Padding="16,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="{ThemeResource DangerBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecordTime" Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="0:00" />
                                    <TextBlock x:Name="RecordHint" Grid.Column="2" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBox x:Name="Composer" Grid.Row="1" MinHeight="46" MaxHeight="180" Padding="16,13,16,6" FontSize="14"
                                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         GotFocus="OnComposerFocus" LostFocus="OnComposerFocus"
                                         TextChanged="OnComposerChanged" PreviewKeyDown="OnComposerKeyDown">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>
                                <Grid Grid.Row="2" Padding="8,2,8,8" ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AttachButton" Style="{StaticResource IconButton}" Click="OnAttach">
                                        <FontIcon Glyph="&#xE723;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="EmojiButton" Grid.Column="1" Style="{StaticResource IconButton}">
                                        <FontIcon Glyph="&#xE76E;" FontSize="16" />
                                        <Button.Flyout>
                                            <Flyout x:Name="EmojiFlyout" Placement="TopEdgeAlignedLeft">
                                                <GridView x:Name="EmojiGrid" Width="316" MaxHeight="248" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEmojiPicked">
                                                    <GridView.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Width="30" Height="30" FontSize="20" Text="{x:Bind}" TextAlignment="Center" FontFamily="Segoe UI Emoji" />
                                                        </DataTemplate>
                                                    </GridView.ItemTemplate>
                                                </GridView>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock x:Name="ComposerHint" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="RecordCancelButton" Grid.Column="3" Style="{StaticResource IconButton}" Visibility="Collapsed" Click="OnRecordCancel">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource DangerBrush}" />
                                    </Button>
                                    <Button x:Name="MicButton" Grid.Column="4" Width="36" Height="36" Padding="0" CornerRadius="18" Margin="0,0,6,0" Style="{StaticResource IconButton}" Click="OnMic">
                                        <FontIcon x:Name="MicGlyph" Glyph="&#xE720;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="SendButton" Grid.Column="5" Width="36" Height="36" Padding="0" CornerRadius="18" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnSend">
                                        <FontIcon FontSize="14" Glyph="&#xE724;" MirroredWhenRightToLeft="True" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
