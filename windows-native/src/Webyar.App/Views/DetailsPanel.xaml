<UserControl
    x:Class="Webyar.App.Views.DetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Webyar.App.Controls">
    <Border Style="{StaticResource PanelBorder}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Padding="18" Spacing="18">
                <!-- Contact -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <controls:Avatar x:Name="ContactAvatar" Size="64" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ContactName" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="ContactEmail" HorizontalAlignment="Center" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" IsTextSelectionEnabled="True" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock x:Name="VisitorHeader" Style="{StaticResource SectionLabel}" />
                    <Grid x:Name="LocationRow" ColumnSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE707;" FontSize="14" Foreground="{ThemeResource Text3Brush}" />
                        <TextBlock x:Name="LocationText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" />
                    </Grid>
                    <Grid x:Name="DeviceRow" ColumnSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource Text3Brush}" />
                        <TextBlock x:Name="DeviceText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" />
                    </Grid>
                    <Grid x:Name="CodeRow" ColumnSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8EC;" FontSize="14" Foreground="{ThemeResource Text3Brush}" />
                        <TextBlock x:Name="CodeText" Grid.Column="1" FontSize="13" IsTextSelectionEnabled="True" />
                    </Grid>
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />

                <!-- Conversation -->
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ConversationHeader" Style="{StaticResource SectionLabel}" />
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StatusLabel" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" />
                        <TextBlock x:Name="StatusValue" Grid.Column="1" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="PriorityLabel" Grid.Row="1" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" />
                        <TextBlock x:Name="PriorityValue" Grid.Row="1" Grid.Column="1" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="AssigneeLabel" Grid.Row="2" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" />
                        <TextBlock x:Name="AssigneeValue" Grid.Row="2" Grid.Column="1" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StartedLabel" Grid.Row="3" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" />
                        <TextBlock x:Name="StartedValue" Grid.Row="3" Grid.Column="1" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />

                <!-- Tags -->
                <StackPanel Spacing="10">
                    <TextBlock x:Name="TagsHeader" Style="{StaticResource SectionLabel}" />
                    <controls:WrapPanel x:Name="TagsPanel" />
                    <TextBlock x:Name="NoTags" Style="{StaticResource MutedText}" />
                    <TextBox x:Name="TagInput" Style="{StaticResource RoundTextBox}" KeyDown="OnTagKeyDown" />
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />

                <!-- Internal notes -->
                <StackPanel Spacing="10">
                    <TextBlock x:Name="NotesHeader" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="NotesPrivacy" Style="{StaticResource MutedText}" FontSize="11.5" />
                    <StackPanel x:Name="NotesList" Spacing="8" />
                    <TextBlock x:Name="NoNotes" Style="{StaticResource MutedText}" />
                    <TextBox x:Name="NoteInput" Style="{StaticResource RoundTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160" />
                    <Button x:Name="AddNoteButton" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Click="OnAddNote" />
                </StackPanel>

                <InfoBar x:Name="Error" Severity="Error" IsClosable="True" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
