<Page
    x:Class="Webyar.App.Views.EmailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Webyar.App.ViewModels"
    Background="Transparent">
    <Grid Padding="10" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,10,4">
                    <TextBlock x:Name="HeaderText" Style="{StaticResource PaneTitle}" VerticalAlignment="Center" />
                    <Button x:Name="ComposeButton" HorizontalAlignment="Right" Style="{StaticResource PillAccentButton}" Click="OnCompose">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock x:Name="ComposeText" />
                        </StackPanel>
                    </Button>
                </Grid>
                <AutoSuggestBox x:Name="Search" Grid.Row="1" Margin="12,6,12,8" QueryIcon="Find" QuerySubmitted="OnSearch" />
                <Grid Grid.Row="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                    <ListView x:Name="List" Padding="6" SelectionMode="Single" SelectionChanged="OnSelect">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EmailThreadItem">
                                <Grid Padding="4,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource BrandBrush}" VerticalAlignment="Top" Margin="0,6,0,0" Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="13" FontWeight="{x:Bind Weight, Mode=OneWay}" Text="{x:Bind From, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <FontIcon Grid.Column="1" Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource WarningBrush}" Visibility="{x:Bind StarVisibility, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Stamp, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock FontSize="13.5" FontWeight="{x:Bind Weight, Mode=OneWay}" Text="{x:Bind Subject, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Foreground="{ThemeResource Text2Brush}" Text="{x:Bind Snippet, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="Empty" Margin="24" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                            <FontIcon FontSize="24" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE715;" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ProgressRing x:Name="Loading" IsActive="True" Width="28" Height="28" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
            <Grid>
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                        <FontIcon FontSize="30" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE715;" />
                    </Border>
                    <TextBlock x:Name="PlaceholderTitle" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="PlaceholderBody" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                </StackPanel>
                <Grid x:Name="ThreadView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="18,12,10,12" ColumnSpacing="8" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SubjectText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <ToggleButton x:Name="StarButton" Padding="8" MinWidth="34" MinHeight="34" CornerRadius="8" BorderThickness="0" Background="Transparent" Click="OnStar">
                                <FontIcon Glyph="&#xE734;" FontSize="15" />
                            </ToggleButton>
                            <Button x:Name="UnreadButton" Style="{StaticResource IconButton}" Click="OnMarkUnread">
                                <FontIcon Glyph="&#xE715;" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <WebView2 x:Name="Body" Grid.Row="1" DefaultBackgroundColor="Transparent" />
                    <StackPanel Grid.Row="2" Padding="14,10,14,14" Spacing="8" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                        <TextBox x:Name="ReplyBox" Style="{StaticResource RoundTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="220" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <TextBlock x:Name="ReplyStatus" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource Text2Brush}" />
                            <Button x:Name="ReplyButton" Style="{StaticResource PillAccentButton}" Click="OnReply" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
