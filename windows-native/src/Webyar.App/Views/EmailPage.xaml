<Page
    x:Class="Webyar.App.Views.EmailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Webyar.App.Views"
    xmlns:controls="using:Webyar.App.Controls"
    Background="Transparent">
    <!--
        The workspace mailbox, laid out like a desktop mail client: the thread
        list on the start side (search, All / Unread / Starred, the prominent
        Write email button) and the reading pane beside it — subject, sender,
        recipients, the action bar, the message in a white card (a WebView2
        with scripts off, earlier messages folded below the latest) and an
        inline composer at the bottom. New mail takes the whole reading pane.
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshKey" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnComposeKey" />
    </Page.KeyboardAccelerators>

    <Grid Padding="10" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Thread list ── -->
        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="16,14,10,4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE715;" FontSize="15" Foreground="{ThemeResource BrandBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="HeaderText" Style="{StaticResource PaneTitle}" VerticalAlignment="Center" />
                            <Border x:Name="UnreadChip" Style="{StaticResource ChipBorder}" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="UnreadChipText" Style="{StaticResource ChipText}" Foreground="{ThemeResource BrandBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="HeaderSub" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Center" Click="OnRefresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>

                <Button x:Name="ComposeButton" Grid.Row="1" Margin="12,8,12,4" MinHeight="38" HorizontalAlignment="Stretch" Style="{StaticResource PillAccentButton}" Click="OnCompose">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock x:Name="ComposeText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <AutoSuggestBox x:Name="Search" Grid.Row="2" Margin="12,6,12,2" QueryIcon="Find" QuerySubmitted="OnSearch" TextChanged="OnSearchTextChanged" />

                <SelectorBar x:Name="Filters" Grid.Row="3" Margin="6,2,6,0" SelectionChanged="OnFilterChanged">
                    <SelectorBarItem x:Name="FilterAll" Tag="all" IsSelected="True" />
                    <SelectorBarItem x:Name="FilterUnread" Tag="unread" />
                    <SelectorBarItem x:Name="FilterStarred" Tag="starred" />
                </SelectorBar>

                <Grid Grid.Row="4" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                    <ListView x:Name="List" Padding="6,6,6,8" SelectionMode="Single" SelectionChanged="OnSelect">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EmailRow">
                                <Grid Padding="2,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Avatar Size="38" VerticalAlignment="Top" DisplayName="{x:Bind AvatarName, Mode=OneWay}" Email="{x:Bind AvatarEmail, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="13.5" FontWeight="{x:Bind SenderWeight, Mode=OneWay}" Foreground="{ThemeResource TextBrush}" Text="{x:Bind Sender, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent" />
                                            <FontIcon Grid.Column="1" Glyph="&#xE723;" FontSize="12" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" Visibility="{x:Bind AttachmentVisibility, Mode=OneWay}" />
                                            <FontIcon Grid.Column="2" Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource WarningBrush}" VerticalAlignment="Center" Visibility="{x:Bind StarVisibility, Mode=OneWay}" />
                                            <TextBlock Grid.Column="3" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Stamp, Mode=OneWay}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="13" FontWeight="{x:Bind SubjectWeight, Mode=OneWay}" Foreground="{ThemeResource TextBrush}" Text="{x:Bind Subject, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent" />
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{ThemeResource BrandBrush}" VerticalAlignment="Center" Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock FontSize="12.5" Foreground="{ThemeResource Text2Brush}" Text="{x:Bind Snippet, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="Empty" Margin="24" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                        <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                            <FontIcon x:Name="EmptyGlyph" FontSize="24" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE715;" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedText}" />
                        <Button x:Name="EmptyRetryButton" HorizontalAlignment="Center" Style="{StaticResource PillButton}" Visibility="Collapsed" Click="OnRefresh" />
                    </StackPanel>
                    <ProgressRing x:Name="Loading" IsActive="True" Width="28" Height="28" />
                </Grid>
            </Grid>
        </Border>

        <!-- ── Reading pane ── -->
        <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ContentRow" Height="*" />
                    <RowDefinition x:Name="ComposerRow" Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="Notice" Margin="12,10,12,0" IsClosable="True" IsOpen="False" Visibility="Collapsed" />

                <Grid Grid.Row="1">
                    <!-- Nothing open -->
                    <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360">
                        <Border Width="80" Height="80" CornerRadius="14" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                            <FontIcon FontSize="32" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE715;" />
                        </Border>
                        <TextBlock x:Name="PlaceholderTitle" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Name="PlaceholderBody" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedText}" />
                        <Button x:Name="PlaceholderComposeButton" Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource PillButton}" Click="OnCompose">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                <TextBlock x:Name="PlaceholderComposeText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- The thread could not be opened -->
                    <StackPanel x:Name="ReadError" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360" Visibility="Collapsed">
                        <Border Width="64" Height="64" CornerRadius="14" Background="{ThemeResource DangerSoftBrush}" HorizontalAlignment="Center">
                            <FontIcon FontSize="26" Foreground="{ThemeResource DangerBrush}" Glyph="&#xE783;" />
                        </Border>
                        <TextBlock x:Name="ReadErrorTitle" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="ReadErrorBody" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedText}" />
                        <Button x:Name="ReadRetryButton" HorizontalAlignment="Center" Style="{StaticResource PillButton}" Click="OnRetryOpen" />
                    </StackPanel>

                    <!-- New mail: a title above the composer, which fills the pane -->
                    <Grid x:Name="NewHeader" Padding="22,16,14,10" ColumnSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE70F;" FontSize="15" Foreground="{ThemeResource BrandBrush}" />
                        </Border>
                        <TextBlock x:Name="NewHeaderText" Grid.Column="1" Style="{StaticResource PaneTitle}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- The open thread -->
                    <Grid x:Name="ThreadView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Subject, chips, star and unread -->
                        <Grid Padding="22,16,12,4" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SubjectText" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" TextReadingOrder="DetectFromContent" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border x:Name="CountChip" Style="{StaticResource ChipBorder}" Visibility="Collapsed">
                                        <TextBlock x:Name="CountText" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <Border x:Name="AttachChip" Style="{StaticResource ChipBorder}" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE723;" FontSize="11" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="AttachCountText" Style="{StaticResource ChipText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                <ToggleButton x:Name="StarButton" Padding="8" MinWidth="34" MinHeight="34" CornerRadius="8" BorderThickness="0" Background="Transparent" Click="OnStar">
                                    <!-- Checked is a soft tint with the brand colour, not a filled blue block. -->
                                    <ToggleButton.Resources>
                                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="BrandSoftBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="BrandSoftBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="BrandSoftBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="BrandBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="BrandBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="BrandBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="BrandSoftBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="BrandSoftBrush" />
                                    </ToggleButton.Resources>
                                    <FontIcon Glyph="&#xE734;" FontSize="15" />
                                </ToggleButton>
                                <Button x:Name="UnreadButton" Style="{StaticResource IconButton}" Click="OnMarkUnread">
                                    <FontIcon Glyph="&#xE715;" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Sender, recipients, date of the latest message -->
                        <Grid Grid.Row="1" Padding="22,10,22,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:Avatar x:Name="SenderAvatar" Size="42" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SenderName" MaxWidth="280" FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" TextReadingOrder="DetectFromContent" />
                                    <TextBlock x:Name="SenderAddress" Grid.Column="1" FontSize="12.5" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" TextReadingOrder="DetectFromContent" />
                                </Grid>
                                <TextBlock x:Name="ToLine" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" TextReadingOrder="DetectFromContent" />
                                <TextBlock x:Name="CcLine" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" TextReadingOrder="DetectFromContent" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="DateText" Grid.Column="2" Margin="0,2,0,0" FontSize="12" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Top" IsTextSelectionEnabled="True" />
                        </Grid>

                        <!-- Action bar -->
                        <ScrollViewer Grid.Row="2" Padding="22,4,22,8" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="ReplyButton" Style="{StaticResource PillButton}" Click="OnReply">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE8CA;" FontSize="13" MirroredWhenRightToLeft="True" />
                                        <TextBlock x:Name="ReplyText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ReplyAllButton" Style="{StaticResource PillButton}" Click="OnReplyAll">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE8C2;" FontSize="13" MirroredWhenRightToLeft="True" />
                                        <TextBlock x:Name="ReplyAllText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ForwardButton" Style="{StaticResource PillButton}" Click="OnForward">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE89C;" FontSize="13" MirroredWhenRightToLeft="True" />
                                        <TextBlock x:Name="ForwardText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Height="20" Margin="4,0" VerticalAlignment="Center" Background="{ThemeResource LineBrush}" />
                                <Button x:Name="CopyButton" Style="{StaticResource IconButton}" VerticalAlignment="Center" Click="OnCopy">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Attachments of the whole thread -->
                        <ScrollViewer x:Name="AttachmentsHost" Grid.Row="3" Padding="22,0,22,8" Visibility="Collapsed" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AttachmentList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:EmailAttachmentRow">
                                        <Button Style="{StaticResource BubbleButtonStyle}" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource Surface2Brush}" IsEnabled="{x:Bind CanOpen}" Tag="{x:Bind}" Click="OnOpenAttachment">
                                            <Grid Padding="8,6,10,6" ColumnSpacing="10" MaxWidth="280">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource BrandSoftBrush}">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource BrandBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind FileName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent" />
                                                    <TextBlock Text="{x:Bind SizeText}" FontSize="11" Foreground="{ThemeResource Text3Brush}" />
                                                </StackPanel>
                                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- The message itself: always on white, so any mail stays readable in dark mode too. -->
                        <Border Grid.Row="4" Margin="16,2,16,12" Padding="6" CornerRadius="12" Background="White" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                            <Grid>
                                <WebView2 x:Name="Body" DefaultBackgroundColor="White" />
                                <ProgressRing x:Name="BodyLoading" Width="28" Height="28" IsActive="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!--
                    Composer: one rounded card, like the chat composer — recipients on
                    top, the subject for new mail and forwards, the text, then Send.
                -->
                <Grid x:Name="ComposerHost" Grid.Row="2" Padding="16,0,16,16" Visibility="Collapsed">
                    <Border
                        x:Name="ComposerCard"
                        CornerRadius="14"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ComposerBorderBrush}"
                        Background="{ThemeResource ComposerBrush}"
                        GotFocus="OnComposerFocus"
                        LostFocus="OnComposerBlur"
                        PreviewKeyDown="OnComposerKeyDown">
                        <Border.Resources>
                            <!-- No box inside the box: the card itself shows focus. -->
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </Border.Resources>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Mode and recipients -->
                            <Grid Padding="10,8,6,6" ColumnSpacing="8" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="9,4" CornerRadius="8" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="ModeGlyph" Glyph="&#xE8CA;" FontSize="12" Foreground="{ThemeResource BrandBrush}" MirroredWhenRightToLeft="True" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ModeText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="ToLabel" Grid.Column="1" FontSize="12.5" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" />
                                <TextBox
                                    x:Name="ToBox"
                                    Grid.Column="2"
                                    MinHeight="0"
                                    Padding="4,6"
                                    FontSize="13"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    FlowDirection="LeftToRight"
                                    VerticalAlignment="Center"
                                    InputScope="EmailSmtpAddress"
                                    IsSpellCheckEnabled="False"
                                    TextChanged="OnComposerChanged" />
                                <Button x:Name="CloseComposerButton" Grid.Column="3" Style="{StaticResource IconButton}" MinWidth="30" MinHeight="30" Padding="6" VerticalAlignment="Center" Click="OnDiscard">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </Grid>

                            <!-- Subject (new mail and forwards) -->
                            <Grid x:Name="SubjectRow" Grid.Row="1" Padding="10,2,10,2" ColumnSpacing="8" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SubjectLabel" FontSize="12.5" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center" />
                                <TextBox x:Name="SubjectBox" Grid.Column="1" MinHeight="0" Padding="4,6" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" TextReadingOrder="DetectFromContent" />
                            </Grid>

                            <TextBox
                                x:Name="BodyBox"
                                Grid.Row="2"
                                MinHeight="72"
                                MaxHeight="240"
                                Padding="14,10,14,6"
                                FontSize="14"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                BorderThickness="0"
                                Background="Transparent"
                                TextReadingOrder="DetectFromContent"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                TextChanged="OnComposerChanged" />

                            <!-- Status, hint, discard, send -->
                            <Grid Grid.Row="3" Padding="12,2,8,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="ComposerStatus" FontSize="12" Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                    <TextBlock x:Name="ComposerHint" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="DiscardButton" Grid.Column="1" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="OnDiscard">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock x:Name="DiscardText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource PillAccentButton}" VerticalAlignment="Center" IsEnabled="False" Click="OnSend">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <!-- The paper plane points the way text runs. -->
                                        <FontIcon Glyph="&#xE724;" FontSize="13" MirroredWhenRightToLeft="True" />
                                        <TextBlock x:Name="SendText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
