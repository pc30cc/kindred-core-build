<Page
    x:Class="Webyar.App.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Webyar.App.ViewModels"
    xmlns:views="using:Webyar.App.Views"
    xmlns:controls="using:Webyar.App.Controls"
    Background="Transparent">
    <Grid Padding="10" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,14,10,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderText" Style="{StaticResource PaneTitle}" />
                        <Border x:Name="TotalChip" Style="{StaticResource ChipBorder}" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="TotalText" Style="{StaticResource ChipText}" Foreground="{ThemeResource BrandBrush}" />
                        </Border>
                    </StackPanel>
                    <Button x:Name="RefreshButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="OnRefresh">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <AutoSuggestBox x:Name="Search" Grid.Row="1" Margin="12,6,12,4" QueryIcon="Find" TextChanged="OnSearchChanged" />

                <!-- The inbox is chosen in the navigation pane now, as in the web sidebar. -->
                <SelectorBar x:Name="Filters" Grid.Row="2" Margin="6,2,6,0" Visibility="Collapsed" SelectionChanged="OnFilterChanged">
                    <SelectorBarItem x:Name="FilterOpen" Tag="Open" IsSelected="True" />
                    <SelectorBarItem x:Name="FilterPending" Tag="Pending" />
                    <SelectorBarItem x:Name="FilterAi" Tag="Ai" />
                    <SelectorBarItem x:Name="FilterResolved" Tag="Resolved" />
                </SelectorBar>

                <Grid Grid.Row="3" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                    <ListView
                        x:Name="List"
                        Padding="6,6,6,8"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConversationItem">
                                <Grid Padding="2,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Avatar Size="46" DisplayName="{x:Bind RawName, Mode=OneWay}" Email="{x:Bind Email, Mode=OneWay}" Os="{x:Bind Os, Mode=OneWay}" CountryCode="{x:Bind CountryCode, Mode=OneWay}" ImageUrl="{x:Bind AvatarUrl, Mode=OneWay}" PresenceState="{x:Bind StatusDot, Mode=OneWay}" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="14" FontWeight="{x:Bind NameWeight, Mode=OneWay}" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind Stamp, Mode=OneWay}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12.5" Foreground="{x:Bind PreviewBrush, Mode=OneWay}" Text="{x:Bind Preview, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <Border Grid.Column="1" Style="{StaticResource ChipBorder}" Padding="6,0" Background="{ThemeResource AiSoftBrush}" Visibility="{x:Bind AiVisibility, Mode=OneWay}">
                                                <FontIcon FontSize="10" Glyph="&#xE945;" Foreground="{ThemeResource AiBrush}" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource ChipBorder}" Padding="7,0" Background="{ThemeResource DangerSoftBrush}" Visibility="{x:Bind PriorityVisibility, Mode=OneWay}">
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource DangerBrush}" Text="{x:Bind PriorityText, Mode=OneWay}" />
                                            </Border>
                                            <Border
                                                Grid.Column="3"
                                                MinWidth="20"
                                                Height="20"
                                                Padding="6,0"
                                                Background="{ThemeResource BrandBrush}"
                                                CornerRadius="10"
                                                Visibility="{x:Bind UnreadVisibility, Mode=OneWay}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" Text="{x:Bind UnreadText, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="Empty" Margin="24" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                            <FontIcon FontSize="24" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE8BD;" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock x:Name="EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ProgressRing x:Name="Loading" IsActive="True" Width="28" Height="28" />
                    <InfoBar x:Name="Error" VerticalAlignment="Bottom" Margin="8" Severity="Warning" IsClosable="False" />
                </Grid>
            </Grid>
        </Border>

        <views:ChatView x:Name="Chat" Grid.Column="1" />
    </Grid>
</Page>
