<Page
    x:Class="Webyar.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,18,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="28,8,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="4">
            <TextBlock x:Name="PageTitle" Margin="2,8,0,4" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- General -->
            <TextBlock x:Name="GeneralHeader" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguagePicker" Grid.Column="1" MinWidth="180" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="فارسی" Tag="fa" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Türkçe" Tag="tr" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AppearanceLabel" />
                        <TextBlock x:Name="AppearanceHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ComboBox x:Name="AppearancePicker" Grid.Column="1" MinWidth="180" SelectionChanged="OnAppearanceChanged" />
                </Grid>
            </Border>

            <!-- Notifications -->
            <TextBlock x:Name="NotificationsHeader" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ToastsLabel" />
                            <TextBlock x:Name="ToastsHint" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ToastsToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnToastsToggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SoundLabel" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="SoundToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnSoundToggled" />
                    </Grid>
                    <TextBlock x:Name="ServerPrefsHint" Style="{StaticResource Hint}" />
                    <HyperlinkButton x:Name="WindowsSettingsLink" Padding="0" Click="OnOpenWindowsSettings" />
                </StackPanel>
            </Border>

            <!-- Desktop -->
            <TextBlock x:Name="DesktopHeader" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StartupLabel" />
                            <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnStartupToggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TrayLabel" />
                            <TextBlock x:Name="TrayHint" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TrayToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnTrayToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <TextBlock x:Name="UpdatesHeader" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="VersionText" />
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" />
                        <ProgressBar x:Name="UpdateProgress" Margin="0,6,0,0" Maximum="100" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CheckButton" Click="OnCheckUpdates" />
                        <Button x:Name="RestartButton" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="OnRestart" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Account -->
            <TextBlock x:Name="AccountHeader" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AccountName" />
                            <TextBlock x:Name="AccountEmail" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Button x:Name="SignOutButton" Grid.Column="1" Click="OnSignOut" />
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ServerLabel" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServerBox" FlowDirection="LeftToRight" IsSpellCheckEnabled="False" />
                            <Button x:Name="ServerSave" Grid.Column="1" Click="OnSaveServer" />
                        </Grid>
                        <TextBlock x:Name="ServerHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
