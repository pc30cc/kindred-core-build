<Page
    x:Class="Webyar.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Webyar.App.Controls"
    Background="Transparent">
    <Page.Resources>
        <ResourceDictionary>
            <!--
                The pane sits straight on the window's Mica (Windows 11) and the
                content is a raised layer with a rounded corner, as in the WinUI
                Gallery. Per theme, not StaticResource aliases: those resolve once
                against the system theme and left a white pane in dark mode.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F4F6F9" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#E3E7EE" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0C0E14" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#242A36" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">1,1,0,0</Thickness>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">10,0,0,0</CornerRadius>
        </ResourceDictionary>
    </Page.Resources>
    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Left"
        IsPaneToggleButtonVisible="True"
        OpenPaneLength="232"
        CompactModeThresholdWidth="900"
        ExpandedModeThresholdWidth="1180"
        SelectionChanged="OnNavigate">
        <NavigationView.PaneHeader>
            <!--
                The workspace, as at the top of the web sidebar. With more than one,
                it opens the list to switch between them.
            -->
            <Button x:Name="WorkspaceButton" Margin="0,0,4,0" Padding="4,3,8,3" MinHeight="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="8">
                        <Border.Background>
                            <ImageBrush x:Name="WorkspaceLogo" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="WorkspaceName" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="130" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <FontIcon x:Name="WorkspaceChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout x:Name="WorkspaceMenu" Placement="BottomEdgeAlignedLeft" Opening="OnWorkspaceMenuOpening" />
                </Button.Flyout>
            </Button>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <!-- The inboxes, as in the web sidebar (AppSidebar.tsx): queues, then the internal and channel groups. -->
            <NavigationViewItem x:Name="InboxItem" Tag="inbox" IsExpanded="True" SelectsOnInvoked="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8BD;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="UnreadBadge" Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem x:Name="InboxOpenItem" Tag="inbox/Open">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8F2;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="InboxAiItem" Tag="inbox/Ai">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE99A;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge x:Name="AiBadge" Visibility="Collapsed" Style="{ThemeResource InformationalValueInfoBadgeStyle}" />
                        </NavigationViewItem.InfoBadge>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="InboxNeedsHumanItem" Tag="inbox/NeedsHuman">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7BA;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge x:Name="NeedsHumanBadge" Visibility="Collapsed" Style="{ThemeResource CriticalValueInfoBadgeStyle}" />
                        </NavigationViewItem.InfoBadge>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="InboxPendingItem" Tag="inbox/Pending">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE823;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="InboxResolvedItem" Tag="inbox/Resolved">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE73E;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="InboxSpamItem" Tag="inbox/Spam">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE733;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge x:Name="SpamBadge" Visibility="Collapsed" Style="{ThemeResource InformationalValueInfoBadgeStyle}" />
                        </NavigationViewItem.InfoBadge>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="InternalInboxItem" SelectsOnInvoked="False" IsExpanded="True">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE902;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.MenuItems>
                            <NavigationViewItem x:Name="ColleaguesItem" Tag="colleagues">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE716;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationViewItem.MenuItems>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="OtherInboxesItem" SelectsOnInvoked="False" IsExpanded="True" Visibility="Collapsed">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ContactsItem" Tag="contacts">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE779;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="VisitorsItem" Tag="visitors">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE909;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="VisitorsBadge" Visibility="Collapsed" Style="{ThemeResource SuccessValueInfoBadgeStyle}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <!-- Website analytics: owners and admins whose plan has the Web Analytics module, as in the web sidebar. -->
            <NavigationViewItem x:Name="AnalyticsItem" Tag="analytics" Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="CallCenterItem" Tag="calls">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE717;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="CallsBadge" Visibility="Collapsed" Style="{ThemeResource CriticalValueInfoBadgeStyle}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <!-- The mailbox: owners and admins whose plan has the Email Inbox module, as in the web sidebar. -->
            <NavigationViewItem x:Name="EmailItem" Tag="email" Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE715;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel Spacing="8">
                <!--
                    The call, while it is docked in a page that is not on screen: who,
                    how long, mute, back to it, out into a window, hang up (the Mac's
                    call bar at the foot of the sidebar). In the narrow rail, the face
                    alone leads back.
                -->
                <Border x:Name="ActiveCallBar" Visibility="Collapsed" Margin="8,0" Padding="10" CornerRadius="14" RequestedTheme="Dark" Background="#0C0E14">
                    <StackPanel Spacing="10">
                        <Button x:Name="ActiveCallBack" Style="{StaticResource BubbleButtonStyle}" HorizontalContentAlignment="Stretch" Click="OnActiveCallBack">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Avatar x:Name="ActiveCallAvatar" Size="30" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="ActiveCallName" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="ActiveCallGlyph" Glyph="&#xE717;" FontSize="9" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ActiveCallStatus" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ActiveCallMute" Width="30" Height="30" Padding="0" CornerRadius="15" BorderThickness="0" Click="OnActiveCallMute">
                                <FontIcon x:Name="ActiveCallMuteGlyph" Glyph="&#xE720;" FontSize="12" />
                            </Button>
                            <Button x:Name="ActiveCallReturn" Grid.Column="1" Width="30" Height="30" Padding="0" CornerRadius="15" BorderThickness="0" Click="OnActiveCallBack">
                                <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                            </Button>
                            <Button x:Name="ActiveCallPopOut" Grid.Column="2" Width="30" Height="30" Padding="0" CornerRadius="15" BorderThickness="0" Click="OnActiveCallPopOut">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </Button>
                            <Button x:Name="ActiveCallHangUp" Grid.Column="4" Width="30" Height="30" Padding="0" CornerRadius="15" BorderThickness="0" Foreground="White" Background="{ThemeResource DangerBrush}" Click="OnActiveCallHangUp">
                                <FontIcon x:Name="ActiveCallHangUpGlyph" Glyph="&#xE778;" FontSize="12" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Button x:Name="ActiveCallRail" Visibility="Collapsed" Margin="4,0" Padding="5" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left" RequestedTheme="Dark" Background="#0C0E14" BorderThickness="0" Click="OnActiveCallBack">
                    <controls:Avatar x:Name="ActiveCallRailAvatar" Size="30" />
                </Button>
                <!--
                    The account: the photo alone, where an icon would be. A plain
                    button rather than a menu item, so the photo sits centred in the
                    compact rail (48 px: 4 margin + 5 padding + 30 photo + 9) instead
                    of being cut in half, and the name and status follow when the
                    pane is open.
                -->
                <Button x:Name="AccountItem" Style="{StaticResource BubbleButtonStyle}" Margin="4,2" Padding="5,6,8,6" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:Avatar x:Name="MeAvatar" Size="30" Kind="operator" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="MeName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="MeStatus" FontSize="11.5" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        </StackPanel>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="AccountMenu" Placement="RightEdgeAlignedBottom" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </NavigationView.PaneFooter>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="Banners" Spacing="4" Margin="12,0,12,4">
                <!-- Super Admin: announcements (Desktop app -> Ads & announcements) and live broadcasts. -->
                <StackPanel x:Name="Announcements" Spacing="4" Margin="0,8,0,0" Visibility="Collapsed" />
                <InfoBar x:Name="UpdateBar" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button x:Name="UpdateButton" Click="OnRestartToUpdate" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="ToastsOffBar" Severity="Warning" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button x:Name="ToastsOffButton" Click="OnOpenWindowsSettings" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
            <Frame x:Name="ContentFrame" Grid.Row="1" />
            <!-- The docked call's page, laid over the place its page keeps for it (CallDock). -->
            <Canvas x:Name="CallLayer" Grid.RowSpan="2" />

            <!--
                Calls from anywhere in the app, floating at the bottom corner as on
                the Mac (380 wide): a call a colleague handed over, above a call
                ringing on the desk.
            -->
            <StackPanel x:Name="CallCards" Grid.RowSpan="2" Width="380" Margin="20" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border x:Name="HandedBar" Visibility="Collapsed" CornerRadius="22" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <Border CornerRadius="22" Background="{ThemeResource BrandBrush}" Opacity="0.10" />
                        <StackPanel Padding="16" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Avatar x:Name="HandedAvatar" Size="44" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8AB;" FontSize="11" Foreground="{ThemeResource BrandBrush}" />
                                        <TextBlock x:Name="HandedTitle" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="HandedName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HandedMeta" FontSize="11.5" Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="HandedError" FontSize="11.5" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap" MaxLines="3" Visibility="Collapsed" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="HandedClose" CornerRadius="8" Click="OnHandedClose" />
                                <Button x:Name="HandedJoin" Grid.Column="2" CornerRadius="8" Click="OnHandedJoin" Foreground="White" Background="{ThemeResource SuccessBrush}" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="HandedJoinGlyph" Glyph="&#xE717;" FontSize="13" />
                                        <TextBlock x:Name="HandedJoinText" />
                                        <ProgressRing x:Name="HandedJoinRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="CallBar" Visibility="Collapsed" CornerRadius="22" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <Border CornerRadius="22" Background="{ThemeResource SuccessBrush}" Opacity="0.10" />
                        <StackPanel Padding="16" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- The caller's face, with a ring spreading from it every 1.2 s while it rings. -->
                                <Grid VerticalAlignment="Center">
                                    <controls:Avatar x:Name="CallBarAvatar" Size="44" />
                                    <Ellipse x:Name="RingPulse" Width="44" Height="44" Stroke="{ThemeResource SuccessBrush}" StrokeThickness="2"
                                             Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="RingPulseScale" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon x:Name="CallBarGlyph" Glyph="&#xE717;" FontSize="11" Foreground="{ThemeResource SuccessBrush}" />
                                        <TextBlock x:Name="CallBarTitle" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="CallBarName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CallBarMeta" FontSize="11.5" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CallBarOpen" CornerRadius="8" Click="OnCallBarOpen" />
                                <Button x:Name="CallBarReject" Grid.Column="2" CornerRadius="8" Click="OnCallBarReject" Foreground="White" Background="{ThemeResource DangerBrush}" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE778;" FontSize="13" />
                                        <TextBlock x:Name="CallBarRejectText" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CallBarAnswer" Grid.Column="3" CornerRadius="8" Click="OnCallBarAnswer" Foreground="White" Background="{ThemeResource SuccessBrush}" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE717;" FontSize="13" />
                                        <TextBlock x:Name="CallBarAnswerText" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </NavigationView>
</Page>
