<Page
    x:Class="Webyar.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Webyar.App.Controls"
    Background="Transparent">
    <Page.Resources>
        <!-- The sidebar is a white column, as in the web console. -->
        <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SurfaceBrush" />
        <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SurfaceBrush" />
        <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="SurfaceBrush" />
        <Thickness x:Key="NavigationViewContentGridBorderThickness">1,1,0,0</Thickness>
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">10,0,0,0</CornerRadius>
        <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="AppBackgroundBrush" />
    </Page.Resources>
    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Left"
        IsPaneToggleButtonVisible="True"
        OpenPaneLength="232"
        CompactModeThresholdWidth="900"
        ExpandedModeThresholdWidth="1180"
        SelectionChanged="OnNavigate">
        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,0" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="8">
                    <Border.Background>
                        <ImageBrush x:Name="WorkspaceLogo" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <TextBlock x:Name="WorkspaceName" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="150" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="InboxItem" Tag="inbox">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8BD;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="UnreadBadge" Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ColleaguesItem" Tag="colleagues">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE716;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="ColleaguesBadge" Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Name="EmailItem" Tag="email">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE715;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ContactsItem" Tag="contacts">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE779;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <NavigationViewItem x:Name="AccountItem" SelectsOnInvoked="False" Tapped="OnAccountTapped">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.Content>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:Avatar x:Name="MeAvatar" Size="26" PresenceState="online" />
                        <TextBlock x:Name="MeName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                    </StackPanel>
                </NavigationViewItem.Content>
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout x:Name="AccountMenu" Placement="RightEdgeAlignedBottom" />
                </FlyoutBase.AttachedFlyout>
            </NavigationViewItem>
        </NavigationView.PaneFooter>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="Banners" Spacing="4" Margin="12,0,12,4">
                <InfoBar x:Name="UpdateBar" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button x:Name="UpdateButton" Click="OnRestartToUpdate" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="ToastsOffBar" Severity="Warning" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button x:Name="ToastsOffButton" Click="OnOpenWindowsSettings" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Page>
