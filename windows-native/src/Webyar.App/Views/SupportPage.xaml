<Page
    x:Class="Webyar.App.Views.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Webyar.App.Controls"
    Background="Transparent">
    <!--
        Settings → Online support: the chat with the platform's own team, as
        the Android app has it. The open conversation (or a fresh page), the
        team's presence and hours while nobody is online, and the composer —
        or, once the conversation ended, its end, its rating and "start a new
        conversation". The conversations that ended are behind "Closed", read
        back with their rating. The transcript is built in code from the rows
        Webyar.Core works out (SupportTimeline), as one list.
    -->
    <Grid Padding="10">
        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Bar: back, the team's face and presence, and the way to the closed conversations. -->
                <Grid Padding="10,10,12,10" ColumnSpacing="12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" VerticalAlignment="Center" Click="OnBack">
                        <FontIcon Glyph="&#xE72B;" FontSize="15" MirroredWhenRightToLeft="True" />
                    </Button>
                    <Grid x:Name="TeamMark" Grid.Column="1" Width="42" Height="42" VerticalAlignment="Center">
                        <Ellipse x:Name="TeamMarkSkeleton" Fill="{ThemeResource ElevatedBrush}" />
                        <Border x:Name="TeamMarkGlyph" CornerRadius="21" Background="{ThemeResource BrandSoftBrush}" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE95B;" FontSize="19" Foreground="{ThemeResource BrandBrush}" />
                        </Border>
                        <controls:Avatar x:Name="TeamAvatar" Size="42" Kind="operator" Visibility="Collapsed" />
                        <Ellipse x:Name="TeamMarkDot" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" StrokeThickness="2" Stroke="{ThemeResource SurfaceBrush}" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent" />
                        <Border x:Name="TitleSkeleton" Width="150" Height="14" CornerRadius="6" HorizontalAlignment="Left" Background="{ThemeResource ElevatedBrush}" Visibility="Collapsed" />
                        <StackPanel x:Name="SubtitleLine" Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="PresenceDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border x:Name="SubtitleSkeleton" Width="110" Height="10" CornerRadius="5" HorizontalAlignment="Left" Background="{ThemeResource ElevatedBrush}" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="ClosedButton" Grid.Column="3" Style="{StaticResource PillButton}" VerticalAlignment="Center" Visibility="Collapsed" Click="OnOpenClosed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="14" />
                            <TextBlock x:Name="ClosedButtonText" />
                            <Border x:Name="ClosedCount" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" Background="{ThemeResource ElevatedBrush}" VerticalAlignment="Center">
                                <TextBlock x:Name="ClosedCountText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource Text2Brush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Nobody is online: leave a message — and when the team is back, and its week. -->
                <Border x:Name="OfflineBanner" Grid.Row="1" Margin="14,10,14,0" Padding="14,12" CornerRadius="12" Background="{ThemeResource BrandSoftBrush}" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE823;" FontSize="18" Foreground="{ThemeResource BrandBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="OfflineText" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Name="NextOpenText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <Button x:Name="HoursToggle" Margin="-8,2,0,0" Padding="8,4" Background="Transparent" BorderThickness="0" Click="OnToggleHours">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="HoursTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}" />
                                    <FontIcon x:Name="HoursChevron" Glyph="&#xE70E;" FontSize="10" Foreground="{ThemeResource BrandBrush}" />
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="HoursLines" Spacing="2" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The transcript, the closed list, or the state in their place. -->
                <Grid x:Name="Body" Grid.Row="2" Margin="0,8,0,0" Background="{ThemeResource ChatBackgroundBrush}" AllowDrop="True" DragOver="OnBodyDragOver" Drop="OnBodyDrop">
                    <ScrollViewer x:Name="TranscriptScroll" Padding="18,6,18,12" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Transcript" MaxWidth="820" FlowDirection="LeftToRight" Spacing="2" VerticalAlignment="Bottom" />
                    </ScrollViewer>

                    <ScrollViewer x:Name="ClosedScroll" Padding="14,8,14,14" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="ClosedList" MaxWidth="820" Spacing="6" />
                    </ScrollViewer>

                    <StackPanel x:Name="Skeleton" Padding="18,14" MaxWidth="820" Spacing="14" VerticalAlignment="Bottom" FlowDirection="LeftToRight" />

                    <StackPanel x:Name="StatePanel" MaxWidth="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                        <Border Width="72" Height="72" CornerRadius="20" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                            <FontIcon x:Name="StateGlyph" FontSize="28" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE8BD;" />
                        </Border>
                        <TextBlock x:Name="StateTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="StateBody" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                        <Button x:Name="RetryButton" HorizontalAlignment="Center" MinWidth="140" Margin="0,6,0,0" Style="{StaticResource AccentButtonStyle}" Click="OnRetryLoad" />
                    </StackPanel>
                </Grid>

                <!-- The bottom: what went wrong, then the composer — or how the conversation ended. -->
                <StackPanel Grid.Row="3" Padding="16,6,16,16" Spacing="8" Background="{ThemeResource ChatBackgroundBrush}">
                    <InfoBar x:Name="Notice" IsClosable="True" Closed="OnNoticeClosed" />

                    <Border x:Name="ComposerCard" CornerRadius="14" BorderBrush="{ThemeResource ComposerBorderBrush}" BorderThickness="1" Background="{ThemeResource ComposerBrush}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="Composer" MinHeight="46" MaxHeight="180" Padding="16,13,16,6" FontSize="14" MaxLength="4000"
                                     AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" TextReadingOrder="DetectFromContent"
                                     GotFocus="OnComposerFocus" LostFocus="OnComposerFocus"
                                     TextChanged="OnComposerChanged" PreviewKeyDown="OnComposerKeyDown">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <Grid Grid.Row="1" Padding="8,2,8,8" ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AttachButton" Style="{StaticResource IconButton}" Click="OnAttach">
                                    <FontIcon Glyph="&#xE723;" FontSize="16" />
                                </Button>
                                <TextBlock x:Name="ComposerHint" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11.5" Foreground="{ThemeResource Text3Brush}" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="SendButton" Grid.Column="2" Width="36" Height="36" Padding="0" CornerRadius="10" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnSend">
                                    <FontIcon FontSize="14" Glyph="&#xE724;" MirroredWhenRightToLeft="True" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Where the composer was, once the conversation ended: how, and the one way on. -->
                    <Border x:Name="EndedPanel" Padding="20,16" CornerRadius="14" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="520">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE930;" FontSize="18" Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock x:Name="EndedTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="EndedBody" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                            <Button x:Name="StartNewButton" HorizontalAlignment="Stretch" Margin="0,4,0,0" Style="{StaticResource AccentButtonStyle}" Click="OnStartNew" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
