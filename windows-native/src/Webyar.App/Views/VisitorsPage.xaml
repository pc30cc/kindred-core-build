<Page
    x:Class="Webyar.App.Views.VisitorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Webyar.App.ViewModels"
    xmlns:controls="using:Webyar.App.Controls"
    xmlns:wv="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
        </Style>
        <Style x:Key="FilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </Page.Resources>

    <Grid Padding="10" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The live list -->
        <Border Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,14,10,2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="HeaderText" Style="{StaticResource PaneTitle}" />
                            <Border Style="{StaticResource ChipBorder}" VerticalAlignment="Center" Background="{ThemeResource SuccessSoftBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CountText" Style="{StaticResource ChipText}" Foreground="{ThemeResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top" Click="OnRefresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    </Button>
                </Grid>
                <AutoSuggestBox x:Name="Search" Grid.Row="1" Margin="12,8,12,6" QueryIcon="Find" TextChanged="OnSearch" />
                <StackPanel Grid.Row="2" Margin="12,0,12,10" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="OnlineFilter" Style="{StaticResource FilterToggle}" Click="OnFilter" />
                        <ToggleButton x:Name="ChatFilter" Style="{StaticResource FilterToggle}" Click="OnFilter" />
                        <ComboBox x:Name="CountryFilter" MinWidth="120" CornerRadius="999" FontSize="12.5" SelectionChanged="OnCountry" />
                    </StackPanel>
                    <ToggleSwitch x:Name="OfflineSwitch" Toggled="OnIncludeOffline" MinWidth="0" />
                </StackPanel>
                <Grid Grid.Row="3" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
                    <ListView x:Name="List" Padding="6" SelectionMode="Single" SelectionChanged="OnSelect">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:VisitorItem">
                                <Grid Padding="2,9" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Avatar
                                        Size="40"
                                        VerticalAlignment="Top"
                                        DisplayName="{x:Bind RawName, Mode=OneWay}"
                                        Email="{x:Bind Email, Mode=OneWay}"
                                        Os="{x:Bind Os, Mode=OneWay}"
                                        CountryCode="{x:Bind CountryCode, Mode=OneWay}"
                                        ImageUrl="{x:Bind AvatarUrl, Mode=OneWay}"
                                        PresenceState="{x:Bind Status, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Style="{StaticResource ChipBorder}" Padding="7,1" Background="{ThemeResource BrandSoftBrush}" Visibility="{x:Bind ChatVisibility, Mode=OneWay}">
                                                <TextBlock Style="{StaticResource ChipText}" FontSize="11" Foreground="{ThemeResource BrandBrush}" Text="{x:Bind ChatText, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="12" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind Where, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind Ago, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{ThemeResource Text3Brush}" Text="{x:Bind PagePath, Mode=OneWay}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" TextAlignment="DetectFromContent" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="Empty" Margin="24" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                        <Border Width="60" Height="60" CornerRadius="30" Background="{ThemeResource BrandSoftBrush}" HorizontalAlignment="Center">
                            <FontIcon FontSize="24" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE909;" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock x:Name="EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ProgressRing x:Name="Loading" IsActive="True" Width="28" Height="28" />
                </Grid>
            </Grid>
        </Border>

        <!-- The selected visitor -->
        <Border x:Name="DetailPane" Grid.Column="1" Style="{StaticResource PanelBorder}" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="14,10" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="OnCloseDetail">
                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel Padding="18,18,18,24" Spacing="16">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <controls:Avatar x:Name="DetailAvatar" Size="72" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DetailName" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <Border x:Name="DetailStatusChip" Style="{StaticResource ChipBorder}" HorizontalAlignment="Center">
                                <TextBlock x:Name="DetailStatusText" Style="{StaticResource ChipText}" />
                            </Border>
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ChatButton" Style="{StaticResource PillAccentButton}" HorizontalAlignment="Stretch" Click="OnChat">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                                    <TextBlock x:Name="ChatButtonText" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource PillButton}" Click="OnCopySession">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel x:Name="DetailRows" Spacing="12" />
                        </Border>
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="HistoryTitle" Style="{StaticResource SectionLabel}" />
                            <StackPanel x:Name="HistoryList" Spacing="0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- The map, with the live numbers over it -->
        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <Grid>
                <wv:WebView2 x:Name="Map" DefaultBackgroundColor="Transparent" />
                <StackPanel x:Name="MapFallback" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE909;" FontSize="34" Foreground="{ThemeResource Text3Brush}" />
                    <TextBlock x:Name="MapFallbackText" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="StatOnlineLabel" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="StatOnline" Style="{StaticResource StatValue}" Foreground="{ThemeResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="StatActiveLabel" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="StatActive" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="StatCountriesLabel" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="StatCountries" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="StatPagesLabel" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="StatPages" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
