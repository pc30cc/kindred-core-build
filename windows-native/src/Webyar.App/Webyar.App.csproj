<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The native Windows app: WinUI 3 on the Windows App SDK, unpackaged and
    self-contained so it installs per user with no prerequisites, and ships
    through Velopack (see .github/workflows/desktop-native.yml). Everything
    that is not UI lives in Webyar.Core.
  -->
  <PropertyGroup>
    <UseXamlCompilerExecutable>true</UseXamlCompilerExecutable>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Webyar.App</RootNamespace>
    <AssemblyName>Webyar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Webyar.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Generates Webyar.pri and the compiled .xbf pages into the publish folder too; without them the published app cannot load its XAML. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <!-- Velopack runs first, from our own Main, so XAML must not generate one. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- WinUI's generated code trips a few analyzers; our own code is held to warnings-as-errors in Core. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!--
    Extra update feed folders this build trusts (Services/UpdateService.cs); the
    official GitHub releases repo is always trusted. Set at build time only, e.g.
    the WebyarUpdateFeeds environment variable (several separated by spaces) or
    dotnet publish -p:WebyarUpdateFeeds=https://updates.example.com/windows/
  -->
  <ItemGroup Condition="'$(WebyarUpdateFeeds)' != ''">
    <AssemblyMetadata Include="WebyarUpdateFeeds" Value="$(WebyarUpdateFeeds)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Webyar.Core\Webyar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
