<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Webyar-Setup.exe: the installer people download, in the app's own look
    (Fluent, as in the WinUI Gallery). It installs Webyar for the signed-in
    user with no administrator rights, as Slack and Discord do: inside is
    Velopack's own setup for the app, run silently, which puts the app in
    %LOCALAPPDATA%\WebyarWindows with its shortcuts and Apps entry and lets it
    update itself in place. It also moves installs of versions 2.2 to 2.5.1
    out of Program Files. .NET Framework 4.8 ships with every supported
    Windows 10 and 11, so this runs with nothing installed first and stays one file.

    build-installer.ps1 builds it with Velopack's setup inside:
      dotnet build -c Release -p:PayloadPath=releases\WebyarWindows-win-Setup.exe
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Webyar-Setup</AssemblyName>
    <RootNamespace>Webyar.Setup</RootNamespace>
    <ApplicationIcon>..\Webyar.App\Assets\Webyar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds for .NET Framework on any machine, with or without the targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Webyar.App\Assets\icon.png" Link="Assets\icon.png" />
    <Resource Include="..\Webyar.App\Assets\Fonts\IRANSans.ttc" Link="Fonts\IRANSans.ttc" />
    <Resource Include="..\Webyar.App\Assets\Fonts\Vazirmatn.ttf" Link="Fonts\Vazirmatn.ttf" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="app-setup.exe" Condition="'$(PayloadPath)' != '' And Exists('$(PayloadPath)')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>
</Project>
