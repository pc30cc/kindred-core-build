<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Webyar-Setup.exe: the installer people download, in the app's own look
    (Fluent, as in the WinUI Gallery). It installs Webyar for all users under
    Program Files, with Start menu and desktop shortcuts and an entry in
    Settings → Apps / Control Panel, and it doubles as the uninstaller
    ("Uninstall Webyar.exe" in the install folder). .NET Framework 4.8 ships
    with every supported Windows 10 and 11, so this runs with nothing
    installed first and stays one file.

    Built twice (build-installer.ps1 does both):
      1. without a payload: the uninstaller
           dotnet build -c Release -o setup-uninstaller
      2. with the published app zipped, and the uninstaller inside
           dotnet build -c Release -p:PayloadPath=payload.zip -p:UninstallerPath=setup-uninstaller\Webyar-Setup.exe
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Webyar-Setup</AssemblyName>
    <RootNamespace>Webyar.Setup</RootNamespace>
    <ApplicationIcon>..\Webyar.App\Assets\Webyar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds for .NET Framework on any machine, with or without the targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Webyar.App\Assets\icon.png" Link="Assets\icon.png" />
    <Resource Include="..\Webyar.App\Assets\Fonts\IRANSans.ttc" Link="Fonts\IRANSans.ttc" />
    <Resource Include="..\Webyar.App\Assets\Fonts\Vazirmatn.ttf" Link="Fonts\Vazirmatn.ttf" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="payload.zip" Condition="'$(PayloadPath)' != '' And Exists('$(PayloadPath)')" />
    <EmbeddedResource Include="$(UninstallerPath)" LogicalName="uninstaller.exe" Condition="'$(UninstallerPath)' != '' And Exists('$(UninstallerPath)')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
