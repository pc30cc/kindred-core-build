{
  "name": "webyar-desktop",
  "productName": "Webyar",
  "version": "1.1.0",
  "description": "Webyar for Windows — the operator inbox, chat, calls and team messaging on the desktop.",
  "author": "Webyar",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "strings": "python3 scripts/convert-ios-strings.py",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.22.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "country-flag-icons": "^1.6.20",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.32.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "zustand": "^5.0.15"
  }
}
